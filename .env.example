# Only PUBLIC client identifiers may live here (they are compiled into the APK).
# NEVER put private keys (OANDA, FMP, broker tokens, Telegram, WhatsApp) here:
# enter them at runtime (stored encrypted via SecretsManager) or serve them through your backend proxy.
SUPABASE_URL="https://destinedfx.supabase.co"
SUPABASE_ANON_KEY="default"
MANAGEMENT_API_ORIGIN="__CONFIGURATION_REQUIRED__"

# Optional PUBLIC GitHub OAuth App Client ID (Device Flow enabled; no client secret is put in the APK).
# Set this at build time to hide the manual Client ID field in the Bot host controls.
CODESPACES_GITHUB_CLIENT_ID="__CONFIGURATION_REQUIRED__"
# Telegram credentials are entered in the Android app and stored encrypted on-device.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
