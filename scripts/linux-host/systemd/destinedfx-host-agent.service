[Unit]
Description=DestinedFX read-only Linux host agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=destinedfx
Group=destinedfx
WorkingDirectory=/opt/destinedfx
EnvironmentFile=-/etc/destinedfx/host.env
ExecStart=/usr/bin/python3 /opt/destinedfx/scripts/linux-host/host-agent.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/proc /sys
ReadWritePaths=/var/lib/destinedfx

[Install]
WantedBy=multi-user.target
