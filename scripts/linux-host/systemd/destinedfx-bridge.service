[Unit]
Description=DestinedFX FastAPI bridge for the self-hosted Linux execution host
After=network-online.target destinedfx-host-agent.service
Requires=destinedfx-host-agent.service
Wants=network-online.target

[Service]
Type=simple
User=destinedfx
Group=destinedfx
WorkingDirectory=/opt/destinedfx/bridge
EnvironmentFile=-/etc/destinedfx/host.env
EnvironmentFile=-/etc/destinedfx/bridge.env
Environment=BRIDGE_HOST_PROFILE=PERSISTENT
Environment=BRIDGE_HOST_MODE=linux-host
Environment=HOST_AGENT_URL=http://127.0.0.1:8787/health/ready
Environment=HOST_AGENT_TOKEN_FILE=%d/host-agent-token
Environment=CREDENTIALS_FERNET_KEY_FILE=%d/credentials-fernet-key
Environment=WORKER_BOOTSTRAP_TOKEN_FILE=%d/worker-bootstrap-token
Environment=PYTHONPATH=/opt/destinedfx/bridge:/opt/destinedfx/managed-worker
LoadCredentialEncrypted=host-agent-token:/etc/credstore.encrypted/destinedfx-host-agent-token.cred
LoadCredentialEncrypted=credentials-fernet-key:/etc/credstore.encrypted/destinedfx-credentials-fernet-key.cred
LoadCredentialEncrypted=worker-bootstrap-token:/etc/credstore.encrypted/destinedfx-worker-bootstrap-token.cred
ExecStart=/opt/destinedfx/venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8000 --no-proxy-headers --timeout-keep-alive 5 --limit-concurrency 100
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
ReadWritePaths=/var/lib/destinedfx

[Install]
WantedBy=multi-user.target
