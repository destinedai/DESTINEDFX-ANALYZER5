[Unit]
Description=DestinedFX MetaTrader 5 terminal
After=destinedfx-xvfb.service network-online.target
Requires=destinedfx-xvfb.service
Wants=network-online.target

[Service]
Type=simple
User=destinedfx
Group=destinedfx
WorkingDirectory=/var/lib/destinedfx/terminal
Environment=DISPLAY=:99
EnvironmentFile=-/etc/destinedfx/mt5.env
ExecStart=/usr/bin/wine /var/lib/destinedfx/terminal/drive_c/Program\ Files/MetaTrader\ 5/terminal64.exe /portable
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/destinedfx

[Install]
WantedBy=multi-user.target
