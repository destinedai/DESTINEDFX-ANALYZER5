# Non-secret host identity and local runtime settings for the DestinedFX-owned Linux host.
# Create this file with bootstrap-self-hosted-host.sh; do not put passwords or tokens here.
DESTINEDFX_HOST_OWNER_UID=__OWNER_UID__
DESTINEDFX_HOST_OWNER_GID=__OWNER_GID__
HOST_GENERATION=__HOST_GENERATION__
DESTINEDFX_WORKER_ID=destinedfx-linux-host-01
BRIDGE_HOST_PROFILE=PERSISTENT
BRIDGE_HOST_MODE=linux-host
EXECUTION_STORAGE_DURABLE=true
BRIDGE_DB_PATH=/var/lib/destinedfx/bridge.sqlite3
DESTINEDFX_HOST_STATE_DIR=/var/lib/destinedfx/host-runtime
DESTINEDFX_SLOT_ROOT=/home/destinedfx-slots
DESTINEDFX_SLOT_RUNTIME=/var/lib/destinedfx/host-runtime/runtime/slot-runtime
DESTINEDFX_CONTROL_PLANE_URL=http://127.0.0.1:8000
HOST_AGENT_URL=http://127.0.0.1:8787/health/ready
HOST_AGENT_PORT=8787
DESTINEDFX_ISOLATED_SLOTS=true
DESTINEDFX_SLOT_MAX_TERMINALS=2
DESTINEDFX_SLOT_POLL_SECONDS=3
DESTINEDFX_AUTH_TIMEOUT_SECONDS=270
DESTINEDFX_MT5_TERMINAL_TEMPLATE=/var/lib/destinedfx/terminal-template
MT5_TERMINAL_EXE=/var/lib/destinedfx/terminal-template/terminal64.exe
MT5_METAEDITOR_EXE=/var/lib/destinedfx/terminal-template/metaeditor64.exe
DESTINEDFX_EA_SOURCE=/opt/destinedfx/mt5-ea/DestinedFXTraderEA.mq5
WINE_BIN=/usr/bin/wine
HOST_AGENT_DISK_PATH=/var/lib/destinedfx
