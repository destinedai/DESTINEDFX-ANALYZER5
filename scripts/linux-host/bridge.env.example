# Non-secret Bridge and public ingress settings. Secrets are systemd encrypted credentials.
BRIDGE_BASE_URL=https://bridge.example.com
BRIDGE_PUBLIC_EXPOSURE=true
EXPECTED_FORWARDED_HOST=bridge.example.com
BRIDGE_HOST=bridge.example.com
APP_DOMAIN=api.example.com
CADDY_EMAIL=operator@example.com
ADMIN_EMAILS=admin@example.com
TRUSTED_PROXY_IPS=127.0.0.1
ALLOW_LOOPBACK_HTTP=false
MAX_BODY_BYTES=65536
PAIR_RATE_LIMIT=10
TOKEN_RATE_LIMIT=180
AUTH_FAIL_LIMIT=10
AUTH_FAIL_WINDOW_SECONDS=300
AUTH_LOCKOUT_SECONDS=900
NEWS_PROVIDER_URL=
NEWS_BLACKOUT_BEFORE_SECONDS=1800
NEWS_BLACKOUT_AFTER_SECONDS=1800
NEWS_MAX_AGE_SECONDS=120
ANALYSIS_PROVIDER_URL=
ANALYSIS_TRUSTED_SOURCES=
ANALYSIS_QUOTE_MAX_AGE_SECONDS=15
ANALYSIS_CLOCK_SKEW_SECONDS=120
MANAGEMENT_STEP_UP_PUBLIC_KEY_FILE=/etc/destinedfx/management-step-up-public.pem
MANAGEMENT_STEP_UP_ISSUER=destinedfx-management
MANAGEMENT_STEP_UP_AUDIENCE=destinedfx-bridge
