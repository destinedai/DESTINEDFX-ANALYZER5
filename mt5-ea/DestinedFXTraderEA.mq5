#property strict
#property version   "1.00"
#property description "DestinedFX MT5 v1 bridge EA; deterministic ICT Silver Bullet subset only."
#include <Trade/Trade.mqh>
CTrade trade;

input string InpBridgeBaseURL="https://your-bridge.example";
input string InpPairingCode="";
input string InpSymbols="EURUSD";
input string InpTimeframes="M5";
input double InpRiskPercent=0.25;
input double InpMaxDailyLossPercent=2.0;
input int InpMaxConcurrentPositions=2;
input int InpPollSeconds=5;
input int InpScanSeconds=10;
input int InpHeartbeatSeconds=5;
input ulong InpMagic=5271026;
input int InpDeviationPoints=20;

// Deliberately conservative deterministic SB subset parameters.
#define HEARTBEAT_STALE_SECONDS 15
#define RECENT_BARS 30
#define ATR_PERIOD 14
#define FVG_MAX_AGE 15
#define SWING_LOOKBACK 8
string g_state="READY",g_terminalToken="",g_terminalId="",g_lastSignal="",g_lastReason="Not started",g_lastError="";
string g_symbols[],g_tfs[]; double g_riskPercent=0.25,g_dailyLossPercent=2.0; int g_maxConcurrent=2; string g_sigState="WAIT",g_sigSymbol="",g_sigTf="",g_sigDirection="",g_sigRationale="Not scanned",g_sigRetcode="",g_sigDeal=""; double g_sigEntry=0,g_sigSL=0,g_sigTP=0,g_sigRisk=0; int g_cursor=0; datetime g_lastScan=0,g_lastHeartbeat=0,g_lastAuthenticatedBridgeUtc=0,g_lastHeartbeatAcceptedUtc=0; double g_dayStartEquity=0; int g_day=-1;
string g_processed[],g_ackOutcomes[],g_ackMessages[]; string g_seenSignals[]; string g_lastCommand="";

string Trim(string s){ StringTrimLeft(s); StringTrimRight(s); return s; }
string IsoUtc(datetime value){ MqlDateTime x; TimeToStruct(value,x); return StringFormat("%04d-%02d-%02dT%02d:%02d:%02dZ",x.year,x.mon,x.day,x.hour,x.min,x.sec); }
int StableHash(string value){long h=0;for(int i=0;i<StringLen(value);i++)h=(h*31+StringGetCharacter(value,i))%2147483647;return (int)h;}
int ServerHash(){return StableHash(AccountInfoString(ACCOUNT_SERVER));}
string DayKey(){ MqlDateTime x; TimeToStruct(TimeCurrent(),x); return StringFormat("DFX_%I64d_%d_%04d%03d",AccountInfoInteger(ACCOUNT_LOGIN),ServerHash(),x.year,x.day_of_year); }
string ObjectAt(string text,int p){ if(p<0||StringGetCharacter(text,p)!='{')return ""; int depth=0;bool quoted=false,esc=false;for(int i=p;i<StringLen(text);i++){ushort ch=StringGetCharacter(text,i);if(quoted){if(esc)esc=false;else if(ch=='\\')esc=true;else if(ch=='\"')quoted=false;}else if(ch=='\"')quoted=true;else if(ch=='{')depth++;else if(ch=='}'&&--depth==0)return StringSubstr(text,p,i-p+1);}return "";}
string ConfigObject(string obj){ int p=StringFind(obj,"\"config\""); if(p<0)return ""; p=StringFind(obj,"{",p); if(p<0)return ""; int depth=0; bool quoted=false,esc=false; for(int i=p;i<StringLen(obj);i++){ushort ch=StringGetCharacter(obj,i); if(quoted){if(esc)esc=false;else if(ch=='\\')esc=true;else if(ch=='\"')quoted=false;}else if(ch=='\"')quoted=true;else if(ch=='{')depth++;else if(ch=='}'&&--depth==0)return StringSubstr(obj,p,i-p+1);} return ""; }
string JArray(string obj,string key){int p=StringFind(obj,"\""+key+"\"");if(p<0)return "";p=StringFind(obj,"[",p);if(p<0)return "";int e=StringFind(obj,"]",p);return e<0?"":StringSubstr(obj,p,e-p+1);}
bool ParseList(string json,string key,string &out[]){string a=JArray(json,key);if(a=="")return false;int l=StringFind(a,"["),e=StringFind(a,"]",l);if(l<0||e<0)return false;string raw=StringSubstr(a,l+1,e-l-1);StringReplace(raw,"\"","");SplitCsv(raw,out);if(ArraySize(out)<1)return false;for(int i=0;i<ArraySize(out);i++)if(out[i]=="")return false;return true;}
bool ValidConfig(string cfg,string &syms[],string &tfs[],double &risk,double &daily,int &concurrent,string &why){if(JStr(cfg,"strategy","")!="ict-silver-bullet"){why="This EA implements only ict-silver-bullet subset";return false;}if(!ParseList(cfg,"symbols",syms)||!ParseList(cfg,"timeframes",tfs)){why="symbols and timeframes must be non-empty arrays";return false;}for(int i=0;i<ArraySize(syms);i++){if(StringFind(syms[i]," ")>=0){why="Invalid symbol list";return false;}for(int j=0;j<i;j++)if(syms[i]==syms[j]){why="Duplicate symbol";return false;}}for(int i=0;i<ArraySize(tfs);i++){if(ParseTF(tfs[i])==PERIOD_CURRENT){why="Unsupported timeframe: "+tfs[i];return false;}for(int j=0;j<i;j++)if(tfs[i]==tfs[j]){why="Duplicate timeframe";return false;}}string rs=JStr(cfg,"risk_percent",DoubleToString(InpRiskPercent,4)),ds=JStr(cfg,"max_daily_loss_percent",DoubleToString(InpMaxDailyLossPercent,4)),cs=JStr(cfg,"max_concurrent_positions",IntegerToString(InpMaxConcurrentPositions));risk=StringToDouble(rs);daily=StringToDouble(ds);double cv=StringToDouble(cs);if(!Finite(risk)||risk<=0||risk>1||!Finite(daily)||daily<=0||daily>100||!Finite(cv)||cv<1||cv>1000||MathFloor(cv)!=cv){why="Invalid risk or position-limit configuration";return false;}concurrent=(int)cv;return true;}
string JsonArray(string &a[]){string r="[";for(int i=0;i<ArraySize(a);i++){if(i)r+=",";r+="\""+Esc(a[i])+"\"";}return r+"]";}
bool MarketReady(string sym,ENUM_TIMEFRAMES tf){ MqlRates rates[]; ArraySetAsSeries(rates,true); if(CopyRates(sym,tf,0,2,rates)<2)return false; return rates[0].time>0 && TimeCurrent()-rates[0].time<=MathMax(120,PeriodSeconds(tf)*3); }
bool Finite(double x){ return MathIsValidNumber(x) && x!=EMPTY_VALUE; }
string Esc(string s){ StringReplace(s,"\\","\\\\"); StringReplace(s,"\"","\\\""); StringReplace(s,"\r",""); StringReplace(s,"\n","\\n"); return s; }
string JStr(string j,string key,string def=""){ string k="\""+key+"\""; int p=StringFind(j,k); if(p<0)return def; p=StringFind(j,":",p+StringLen(k)); if(p<0)return def; p++; while(p<StringLen(j)&&(StringGetCharacter(j,p)==' '||StringGetCharacter(j,p)=='\t'))p++; if(StringGetCharacter(j,p)=='\"'){int e=p+1; while(e<StringLen(j)){if(StringGetCharacter(j,e)=='\"'&&StringGetCharacter(j,e-1)!='\\')break;e++;} return StringSubstr(j,p+1,e-p-1);} int e=p; while(e<StringLen(j)&&StringGetCharacter(j,e)!=','&&StringGetCharacter(j,e)!='}'&&StringGetCharacter(j,e)!=']')e++; return Trim(StringSubstr(j,p,e-p)); }
double JNum(string j,string k,double d){string s=JStr(j,k,""); if(s=="")return d; return StringToDouble(s);}
void RevokeSession(string reason){g_state="STOPPED";g_terminalToken="";g_lastAuthenticatedBridgeUtc=0;g_lastError=reason;g_lastReason="Bridge authorization revoked; fresh pairing code and EA reinitialization required";FileDelete("DestinedFX_terminal_token.txt");}
string Api(string method,string path,string body="",bool auth=true){ string url=InpBridgeBaseURL+path; char data[],result[]; string headers="Content-Type: application/json\r\n"; if(auth&&g_terminalToken!="")headers+="Authorization: Bearer "+g_terminalToken+"\r\n"; if(body!=""){int n=StringToCharArray(body,data,0,WHOLE_ARRAY,CP_UTF8);if(n>0&&data[n-1]==0)ArrayResize(data,n-1);}else ArrayResize(data,0); string respHeaders; ResetLastError(); int code=WebRequest(method,url,headers,10000,data,result,respHeaders); if(auth&&(code==401||code==403)){RevokeSession(StringFormat("Authenticated bridge request returned HTTP %d; session revoked",code));return "";} if(code<200||code>=300){g_lastError=StringFormat("WebRequest %s %s returned %d, error %d",method,path,code,GetLastError()); return "";} if(auth)g_lastAuthenticatedBridgeUtc=TimeGMT(); return CharArrayToString(result,0,-1,CP_UTF8); }
string ReadToken(){int h=FileOpen("DestinedFX_terminal_token.txt",FILE_READ|FILE_TXT|FILE_ANSI); if(h==INVALID_HANDLE)return ""; string s=FileReadString(h);FileClose(h);return Trim(s);}
bool AtomicWrite(string name,string text){string tmp=name+".tmp";int h=FileOpen(tmp,FILE_WRITE|FILE_TXT|FILE_ANSI);if(h==INVALID_HANDLE)return false;FileWriteString(h,text);FileFlush(h);FileClose(h);string bak=name+".bak";FileDelete(bak);if(FileIsExist(name)&&!FileMove(name,0,bak,0)){FileDelete(tmp);return false;}if(!FileMove(tmp,0,name,0)){if(FileIsExist(bak))FileMove(bak,0,name,0);FileDelete(tmp);return false;}FileDelete(bak);return true;}
bool SaveToken(string s){return AtomicWrite("DestinedFX_terminal_token.txt",s);}
string Identity(){return StringFormat("%I64d|%s|%s",AccountInfoInteger(ACCOUNT_LOGIN),AccountInfoString(ACCOUNT_SERVER),TerminalInfoString(TERMINAL_DATA_PATH));}
string MakeInstanceId(){return StringFormat("%I64d-%d",AccountInfoInteger(ACCOUNT_LOGIN),StableHash(Identity()));}
bool Claim(){ if(InpPairingCode==""){g_lastReason="Pairing code required";return false;} string b=StringFormat("{\"pairing_code\":\"%s\",\"terminal_instance_id\":\"%s\",\"account\":{\"login\":\"%I64d\",\"server\":\"%s\",\"company\":\"%s\",\"currency\":\"%s\"}}",Esc(InpPairingCode),Esc(MakeInstanceId()),AccountInfoInteger(ACCOUNT_LOGIN),Esc(AccountInfoString(ACCOUNT_SERVER)),Esc(AccountInfoString(ACCOUNT_COMPANY)),Esc(AccountInfoString(ACCOUNT_CURRENCY))); string r=Api("POST","/v1/terminal/claim",b,false); if(r=="")return false; g_terminalId=JStr(r,"terminal_id");g_terminalToken=JStr(r,"terminal_token");if(g_terminalToken=="")return false;if(!SaveToken(g_terminalToken)){g_terminalToken="";g_lastReason="Claim received but terminal-token persistence failed; refusing authenticated operation";return false;}g_lastReason="Terminal claimed";return true; }
ENUM_TIMEFRAMES ParseTF(string s){ if(s=="M1")return PERIOD_M1;if(s=="M5")return PERIOD_M5;if(s=="M15")return PERIOD_M15;if(s=="M30")return PERIOD_M30;if(s=="H1")return PERIOD_H1;if(s=="H4")return PERIOD_H4;if(s=="D1")return PERIOD_D1;return PERIOD_CURRENT; }
void SplitCsv(string src,string &out[]){StringSplit(src,',',out);for(int i=0;i<ArraySize(out);i++)out[i]=Trim(out[i]);}
bool IsKillzone(datetime utc){MqlDateTime x;TimeToStruct(utc,x);int m=x.hour*60+x.min;return (m>=420&&m<540)||(m>=810&&m<930)||(m>=1080&&m<1200);}
int CountPositions(){int n=0;for(int i=PositionsTotal()-1;i>=0;i--){ulong t=PositionGetTicket(i);if(t>0)n++;}return n;}
int CountOurPositions(){int n=0;for(int i=PositionsTotal()-1;i>=0;i--){ulong t=PositionGetTicket(i);if(t>0&&PositionGetInteger(POSITION_MAGIC)==(long)InpMagic)n++;}return n;}
double TodayClosedPnl(){MqlDateTime z;TimeToStruct(TimeCurrent(),z);z.hour=0;z.min=0;z.sec=0;datetime from=StructToTime(z);if(!HistorySelect(from,TimeCurrent()))return 0;double p=0;for(int i=HistoryDealsTotal()-1;i>=0;i--){ulong d=HistoryDealGetTicket(i);if(d>0)p+=HistoryDealGetDouble(d,DEAL_PROFIT)+HistoryDealGetDouble(d,DEAL_COMMISSION)+HistoryDealGetDouble(d,DEAL_SWAP);}return p;}
bool RiskDayOK(){ string key=DayKey(); if(!GlobalVariableCheck(key)){ if(!GlobalVariableSet(key,AccountInfoDouble(ACCOUNT_EQUITY)))return false; } g_dayStartEquity=GlobalVariableGet(key); MqlDateTime z;TimeToStruct(TimeCurrent(),z);g_day=z.day_of_year;double lim=g_dayStartEquity*g_dailyLossPercent/100.0;return g_dayStartEquity>0&&TodayClosedPnl()>-lim&&AccountInfoDouble(ACCOUNT_EQUITY)>g_dayStartEquity-lim; }
string TFLabel(ENUM_TIMEFRAMES tf){return EnumToString(tf);}
string SignalKey(string sym,ENUM_TIMEFRAMES tf,datetime bar,bool bull){return sym+"|"+TFLabel(tf)+"|"+IntegerToString((int)bar)+"|"+(bull?"B":"S");}
bool Seen(string k){for(int i=0;i<ArraySize(g_seenSignals);i++)if(g_seenSignals[i]==k)return true;return false;}
string SeenFile(){return StringFormat("DestinedFX_seen_%I64d_%d.txt",AccountInfoInteger(ACCOUNT_LOGIN),ServerHash());}
bool PersistSeen(){string text="";for(int i=0;i<ArraySize(g_seenSignals);i++)text+=g_seenSignals[i]+"\n";return AtomicWrite(SeenFile(),text);}
bool Remember(string k){if(Seen(k))return true;int n=ArraySize(g_seenSignals);ArrayResize(g_seenSignals,n+1);g_seenSignals[n]=k;if(n>=1000){for(int i=1;i<n+1;i++)g_seenSignals[i-1]=g_seenSignals[i];ArrayResize(g_seenSignals,n);}if(!PersistSeen()){ArrayResize(g_seenSignals,n);return false;}return true;}
// A qualifying setup requires a recent three-candle directional FVG, CE proximity, killzone,
// and a sweep/rejection plus displacement candle in the same direction. This is a subset, not full app parity.
bool FindSetup(string sym,ENUM_TIMEFRAMES tf,bool &bull,double &entry,double &sl,double &tp,string &why,datetime &signalBar){ MqlRates r[];ArraySetAsSeries(r,true);int got=CopyRates(sym,tf,0,80,r);if(got<50){why="Insufficient bars";return false;} MqlTick q;if(!SymbolInfoTick(sym,q)||!Finite(q.bid)||!Finite(q.ask)||q.bid<=0||q.ask<=q.bid||TimeCurrent()-q.time>120){why="Missing/stale quote";return false;} int ah=iATR(sym,tf,ATR_PERIOD);if(ah==INVALID_HANDLE){why="ATR unavailable";return false;}double ab[];ArraySetAsSeries(ab,true);if(CopyBuffer(ah,0,1,1,ab)!=1){IndicatorRelease(ah);why="ATR unavailable";return false;}double atr=ab[0];IndicatorRelease(ah);if(!Finite(atr)||atr<=0){why="ATR unavailable";return false;} double spread=q.ask-q.bid; int fvg=-1;bool dir=false;double lo=0,hi=0;
 for(int i=1;i<=FVG_MAX_AGE&&i<got-2;i++){ // index i newest closed candle; compare it with two bars older
   if(r[i].low>r[i+2].high){fvg=i;dir=true;lo=r[i+2].high;hi=r[i].low;break;}
   if(r[i].high<r[i+2].low){fvg=i;dir=false;lo=r[i].high;hi=r[i+2].low;break;}
 }
 if(fvg<0){why="No recent directional 3-candle FVG";return false;} double ce=(lo+hi)/2.0,mid=(q.bid+q.ask)/2.0;if(MathAbs(mid-ce)>MathMax(.25*atr,2.0*spread)){why="Price outside FVG CE tolerance";return false;} if(!IsKillzone(TimeGMT())){why="Outside UTC Silver Bullet killzones";return false;}
 // Sweep liquidity in prior swing range, then a directional displacement body >= 0.5 ATR.
 int sw=-1;double swing=0;for(int i=fvg+1;i<MathMin(fvg+SWING_LOOKBACK+1,got-2);i++){if(dir){double prior=r[i+1].low;if(r[i].low<prior&&r[i].close>prior){sw=i;swing=r[i].low;break;}}else{double prior=r[i+1].high;if(r[i].high>prior&&r[i].close<prior){sw=i;swing=r[i].high;break;}}}
 if(sw<0){why="No directional liquidity sweep/rejection";return false;} bool disp=dir?(r[fvg].close>r[fvg].open&&r[fvg].close-r[fvg].open>=.5*atr):(r[fvg].close<r[fvg].open&&r[fvg].open-r[fvg].close>=.5*atr);if(!disp){why="No same-direction displacement candle >= 0.5 ATR";return false;}
 bull=dir;entry=dir?q.ask:q.bid;double point=SymbolInfoDouble(sym,SYMBOL_POINT),tick=SymbolInfoDouble(sym,SYMBOL_TRADE_TICK_SIZE);double minstop=(double)SymbolInfoInteger(sym,SYMBOL_TRADE_STOPS_LEVEL)*point;double buffer=MathMax(.25*atr,MathMax(2*spread,minstop));sl=dir?swing-buffer:swing+buffer;if((dir&&sl>=entry)||(!dir&&sl<=entry)){why="Invalid stop side";return false;} if(MathAbs(entry-sl)<MathMax(minstop,tick)){why="Stop below broker minimum";return false;}double risk=MathAbs(entry-sl);tp=dir?entry+2.0*risk:entry-2.0*risk;signalBar=r[fvg].time;return true; }
int VolDigits(double step){int d=0;while(d<8&&MathAbs(step-NormalizeDouble(step,d))>1e-9)d++;return d;}
bool Place(string sym,ENUM_TIMEFRAMES tf,bool bull,double entry,double sl,double tp,datetime bt,string key){if(g_state!="RUNNING"||g_lastAuthenticatedBridgeUtc==0||TimeGMT()-g_lastAuthenticatedBridgeUtc>=HEARTBEAT_STALE_SECONDS){g_state="STOPPED";g_lastError="No authenticated bridge response within HEARTBEAT_STALE_SECONDS=15; stopped without liquidation";g_lastReason=g_lastError;return false;}if(!TerminalInfoInteger(TERMINAL_CONNECTED)||!MQLInfoInteger(MQL_TRADE_ALLOWED)||!AccountInfoInteger(ACCOUNT_TRADE_ALLOWED)){g_lastReason="Terminal/broker trade permission unavailable";return false;}if(!RiskDayOK()||CountOurPositions()>=g_maxConcurrent){g_lastReason="Daily loss or concurrent position limit";return false;}if(!SymbolSelect(sym,true)){g_lastReason="Symbol unavailable";return false;}MqlTick q;if(!SymbolInfoTick(sym,q)||q.bid<=0||q.ask<=q.bid||TimeCurrent()-q.time>120){g_lastReason="Quote stale before order";return false;}double point=SymbolInfoDouble(sym,SYMBOL_POINT),tick=SymbolInfoDouble(sym,SYMBOL_TRADE_TICK_SIZE),stopLevel=SymbolInfoInteger(sym,SYMBOL_TRADE_STOPS_LEVEL)*point;if(point<=0||tick<=0){g_lastReason="Invalid symbol tick size";return false;}entry=bull?q.ask:q.bid; sl=bull?MathFloor(sl/tick)*tick:MathCeil(sl/tick)*tick; tp=bull?MathCeil(tp/tick)*tick:MathFloor(tp/tick)*tick;sl=NormalizeDouble(sl,(int)SymbolInfoInteger(sym,SYMBOL_DIGITS));tp=NormalizeDouble(tp,(int)SymbolInfoInteger(sym,SYMBOL_DIGITS));if((bull&&(sl>=entry||tp<=entry))||(!bull&&(sl<=entry||tp>=entry))||MathAbs(entry-sl)<MathMax(tick,stopLevel)||MathAbs(tp-entry)/MathAbs(entry-sl)<2.0){g_lastReason="Fresh quote violates stop/target side, minimum stop, or 2R";return false;}double base=MathMin(AccountInfoDouble(ACCOUNT_BALANCE),AccountInfoDouble(ACCOUNT_EQUITY));if(!Finite(base)||base<=0||g_riskPercent<=0||g_riskPercent>1.0){g_lastReason="Invalid account/risk configuration";return false;}double loss=0;if(!OrderCalcProfit(bull?ORDER_TYPE_BUY:ORDER_TYPE_SELL,sym,1.0,entry,sl,loss)||!Finite(loss)||loss>=0){g_lastReason="Risk calculation failed";return false;}double budget=base*g_riskPercent/100.0,step=SymbolInfoDouble(sym,SYMBOL_VOLUME_STEP),vmin=SymbolInfoDouble(sym,SYMBOL_VOLUME_MIN),vmax=SymbolInfoDouble(sym,SYMBOL_VOLUME_MAX),raw=budget/MathAbs(loss);if(step<=0||vmin<=0||raw<vmin){g_lastReason="Risk size below broker minimum";return false;}double vol=NormalizeDouble(MathMin(vmax,MathFloor(raw/step+1e-10)*step),VolDigits(step));double checked=0,reward=0;if(vol<vmin||!OrderCalcProfit(bull?ORDER_TYPE_BUY:ORDER_TYPE_SELL,sym,vol,entry,sl,checked)||!OrderCalcProfit(bull?ORDER_TYPE_BUY:ORDER_TYPE_SELL,sym,vol,entry,tp,reward)||MathAbs(checked)>budget+0.01||reward<=0||reward/MathAbs(checked)<2.0){g_lastReason="Fresh-price risk cap or 2R validation failed";return false;}double margin=0;if(!OrderCalcMargin(bull?ORDER_TYPE_BUY:ORDER_TYPE_SELL,sym,vol,entry,margin)||AccountInfoDouble(ACCOUNT_MARGIN_FREE)<margin*1.10){g_lastReason="Insufficient margin";return false;}if(!RiskDayOK()){g_lastReason="Daily loss cap changed before order";return false;}if(!Remember(key)){g_lastReason="Signal deduplication state could not be persisted; order blocked";return false;}trade.SetExpertMagicNumber(InpMagic);trade.SetDeviationInPoints(InpDeviationPoints);trade.SetTypeFillingBySymbol(sym);bool ok=bull?trade.Buy(vol,sym,0,sl,tp,"DFX ICT SB subset"):trade.Sell(vol,sym,0,sl,tp,"DFX ICT SB subset");uint rc=trade.ResultRetcode();ulong deal=trade.ResultDeal();if(!ok||(rc!=TRADE_RETCODE_DONE&&rc!=TRADE_RETCODE_PLACED&&rc!=TRADE_RETCODE_DONE_PARTIAL)||((rc==TRADE_RETCODE_DONE||rc==TRADE_RETCODE_DONE_PARTIAL)&&deal==0)){g_lastError=StringFormat("Order not verified retcode %u deal %I64u: %s",rc,deal,trade.ResultRetcodeDescription());g_lastReason=g_lastError;return false;}g_lastSignal=key;g_sigState="ORDER_ACCEPTED";g_sigRetcode=IntegerToString((int)rc);g_sigDeal=(string)deal;g_lastReason="Order accepted for processing, retcode="+IntegerToString((int)rc);g_sigRationale=(rc==TRADE_RETCODE_PLACED?"Order placed; fill not confirmed":"Order execution confirmed");return true;}
void SetWait(string sym,string tf,string why){g_sigState="WAIT";g_sigSymbol=sym;g_sigTf=tf;g_sigDirection="";g_sigEntry=0;g_sigSL=0;g_sigTP=0;g_sigRisk=g_riskPercent;g_sigRationale=why;g_sigRetcode="";g_sigDeal="";g_lastReason=why;}
void Scan(){if(g_state!="RUNNING"||g_lastHeartbeatAcceptedUtc==0||TimeGMT()-g_lastHeartbeatAcceptedUtc>=HEARTBEAT_STALE_SECONDS)return;SetWait("","","No eligible setup in active scan list");for(int s=0;s<ArraySize(g_symbols);s++){string sym=g_symbols[s];if(!SymbolSelect(sym,true)){SetWait(sym,"","Symbol unavailable");continue;}for(int t=0;t<ArraySize(g_tfs);t++){ENUM_TIMEFRAMES tf=ParseTF(g_tfs[t]);string why;bool bull;double en,sl,tp;datetime bt;if(!FindSetup(sym,tf,bull,en,sl,tp,why,bt)){SetWait(sym,g_tfs[t],why);continue;}string key=SignalKey(sym,tf,bt,bull);g_sigSymbol=sym;g_sigTf=g_tfs[t];g_sigDirection=bull?"BUY":"SELL";g_sigEntry=en;g_sigSL=sl;g_sigTP=tp;g_sigRisk=g_riskPercent;g_sigRationale="Eligible ICT Silver Bullet subset setup";if(Seen(key)){SetWait(sym,g_tfs[t],"Duplicate signal suppressed");continue;}bool accepted=Place(sym,tf,bull,en,sl,tp,bt,key);if(!accepted){g_sigState="REJECTED";g_sigRationale=g_lastReason;g_sigRetcode=IntegerToString((int)trade.ResultRetcode());g_sigDeal=(string)trade.ResultDeal();}}}}
void Ack(string id,string outcome,string msg){string b=StringFormat("{\"outcome\":\"%s\",\"state\":\"%s\",\"message\":\"%s\"}",outcome,g_state,Esc(msg));Api("POST","/v1/terminal/commands/"+id+"/ack",b);}
void SaveCursor(){AtomicWrite("DestinedFX_cursor.txt",IntegerToString(g_cursor));}
void PersistProcessed(){string text="";for(int i=0;i<ArraySize(g_processed);i++)text+=g_processed[i]+"|"+g_ackOutcomes[i]+"|"+g_ackMessages[i]+"\n";AtomicWrite("DestinedFX_processed.txt",text);}
void LoadState(){g_terminalToken=ReadToken();int h=FileOpen("DestinedFX_cursor.txt",FILE_READ|FILE_TXT);if(h!=INVALID_HANDLE){g_cursor=(int)StringToInteger(FileReadString(h));FileClose(h);}h=FileOpen("DestinedFX_processed.txt",FILE_READ|FILE_TXT|FILE_ANSI);if(h!=INVALID_HANDLE){while(!FileIsEnding(h)&&ArraySize(g_processed)<1000){string row=Trim(FileReadString(h)),parts[];if(row=="")continue;StringSplit(row,'|',parts);int n=ArraySize(g_processed);ArrayResize(g_processed,n+1);ArrayResize(g_ackOutcomes,n+1);ArrayResize(g_ackMessages,n+1);g_processed[n]=parts[0];g_ackOutcomes[n]=ArraySize(parts)>1?parts[1]:"REJECTED";g_ackMessages[n]=ArraySize(parts)>2?parts[2]:"Previous outcome unavailable; not re-applied";}FileClose(h);}h=FileOpen(SeenFile(),FILE_READ|FILE_TXT|FILE_ANSI);if(h!=INVALID_HANDLE){while(!FileIsEnding(h)&&ArraySize(g_seenSignals)<1000){string k=Trim(FileReadString(h));if(k!=""&&StringFind(k,"|")>0){int n=ArraySize(g_seenSignals);ArrayResize(g_seenSignals,n+1);g_seenSignals[n]=k;}}FileClose(h);}g_state="READY";}
void ProcessCommands(){if(g_terminalToken=="")return;string r=Api("GET","/v1/terminal/commands?cursor="+IntegerToString(g_cursor));if(r=="")return;int c=(int)JNum(r,"cursor",g_cursor); // parse documented command objects with bounded extraction
 int pos=StringFind(r,"\"commands\"");if(pos>=0){pos=StringFind(r,"{",pos);while(pos>=0){string obj=ObjectAt(r,pos);if(obj=="")break;int end=pos+StringLen(obj)-1;string id=JStr(obj,"id"),action=JStr(obj,"action");if(id=="")break;bool done=false;for(int i=0;i<ArraySize(g_processed);i++)if(g_processed[i]==id)done=true;if(done){for(int ai=0;ai<ArraySize(g_processed);ai++)if(g_processed[ai]==id)Ack(id,g_ackOutcomes[ai],g_ackMessages[ai]);}else{string outcome="APPLIED",msg="Command applied";if(action=="START"){string cfgobj=ConfigObject(obj),why;string syms[],tfs[];double risk,daily;int concurrent;if(!ValidConfig(cfgobj,syms,tfs,risk,daily,concurrent,why)){g_state="STOPPED";outcome="REJECTED";msg=why;}else if(!TerminalInfoInteger(TERMINAL_CONNECTED)||!MQLInfoInteger(MQL_TRADE_ALLOWED)||!AccountInfoInteger(ACCOUNT_TRADE_ALLOWED)){g_state="STOPPED";outcome="REJECTED";msg="Terminal connectivity/trade permission check failed";}else if(AccountInfoDouble(ACCOUNT_BALANCE)<=0||AccountInfoDouble(ACCOUNT_EQUITY)<=0){g_state="STOPPED";outcome="REJECTED";msg="Invalid account snapshot";}else{bool ready=true;for(int si=0;si<ArraySize(syms);si++){if(!SymbolSelect(syms[si],true))ready=false;for(int ti=0;ti<ArraySize(tfs);ti++){ENUM_TIMEFRAMES mtf=ParseTF(tfs[ti]);MqlRates hr[];ArraySetAsSeries(hr,true);MqlTick tq;if(mtf==PERIOD_CURRENT||!MarketReady(syms[si],mtf)||CopyRates(syms[si],mtf,0,80,hr)<50||!SymbolInfoTick(syms[si],tq)||tq.bid<=0||tq.ask<=tq.bid||TimeCurrent()-tq.time>120)ready=false;}}if(!ready){g_state="STOPPED";outcome="REJECTED";msg="Requested symbols/timeframes lack fresh quotes or sufficient history";}else{ArrayCopy(g_symbols,syms);ArrayCopy(g_tfs,tfs);g_riskPercent=risk;g_dailyLossPercent=daily;g_maxConcurrent=concurrent;g_state="RUNNING";msg="Started with validated runtime configuration";}}}else if(action=="STOP"||action=="EMERGENCY_STOP"){g_state="STOPPED";msg="New entries stopped; open positions and broker SL/TP left untouched";}else if(action=="PAUSE"){g_state="PAUSED";msg="Paused; open positions untouched";}else if(action=="RESUME"){if(TerminalInfoInteger(TERMINAL_CONNECTED)&&MQLInfoInteger(MQL_TRADE_ALLOWED)&&AccountInfoInteger(ACCOUNT_TRADE_ALLOWED)){g_state="RUNNING";msg="Resumed";}else{outcome="REJECTED";msg="Terminal checks failed";}}else{outcome="REJECTED";msg="Unknown action";}int n=ArraySize(g_processed);ArrayResize(g_processed,n+1);ArrayResize(g_ackOutcomes,n+1);ArrayResize(g_ackMessages,n+1);g_processed[n]=id;g_ackOutcomes[n]=outcome;g_ackMessages[n]=msg;PersistProcessed();Ack(id,outcome,msg);}pos=StringFind(r,"{",end+1);if(pos<0)break;}}
 if(c>g_cursor){g_cursor=c;SaveCursor();}}
string StateJson(){string state=g_state;if(g_state=="RUNNING"&&(!TerminalInfoInteger(TERMINAL_CONNECTED)||!MQLInfoInteger(MQL_TRADE_ALLOWED)||!AccountInfoInteger(ACCOUNT_TRADE_ALLOWED)))state="ERROR";return state;}
string PositionsJson(){string a="[";bool first=true;for(int i=PositionsTotal()-1;i>=0;i--){ulong ticket=PositionGetTicket(i);if(!ticket)continue;if(!first)a+=",";first=false;ulong pid=(ulong)PositionGetInteger(POSITION_IDENTIFIER);a+=StringFormat("{\"ticket\":\"%I64u\",\"position_id\":\"%I64u\",\"symbol\":\"%s\",\"direction\":\"%s\",\"volume\":%.4f,\"open_price\":%.10f,\"stop_loss\":%.10f,\"take_profit\":%.10f,\"floating_profit\":%.2f,\"commission\":null,\"swap\":%.2f}",ticket,pid,Esc(PositionGetString(POSITION_SYMBOL)),PositionGetInteger(POSITION_TYPE)==POSITION_TYPE_BUY?"BUY":"SELL",PositionGetDouble(POSITION_VOLUME),PositionGetDouble(POSITION_PRICE_OPEN),PositionGetDouble(POSITION_SL),PositionGetDouble(POSITION_TP),PositionGetDouble(POSITION_PROFIT),PositionGetDouble(POSITION_SWAP));}return a+"]";}
string DealsJson(){string a="[";bool first=true;datetime from=TimeCurrent()-86400*7;if(HistorySelect(from,TimeCurrent()))for(int i=HistoryDealsTotal()-1,n=0;i>=0&&n<30;i--,n++){ulong d=HistoryDealGetTicket(i);if(!d)continue;long entry=HistoryDealGetInteger(d,DEAL_ENTRY);if(entry!=DEAL_ENTRY_OUT&&entry!=DEAL_ENTRY_OUT_BY&&entry!=DEAL_ENTRY_INOUT)continue;if(!first)a+=",";first=false;ulong pid=(ulong)HistoryDealGetInteger(d,DEAL_POSITION_ID);a+=StringFormat("{\"ticket\":\"%I64u\",\"position_id\":\"%I64u\",\"symbol\":\"%s\",\"closed_at\":\"%s\",\"profit\":%.2f,\"commission\":%.2f,\"swap\":%.2f}",d,pid,Esc(HistoryDealGetString(d,DEAL_SYMBOL)),IsoUtc((datetime)HistoryDealGetInteger(d,DEAL_TIME)),HistoryDealGetDouble(d,DEAL_PROFIT),HistoryDealGetDouble(d,DEAL_COMMISSION),HistoryDealGetDouble(d,DEAL_SWAP));}return a+"]";}
string LastSignalJson(){if(g_sigSymbol=="")return "null";return StringFormat("{\"state\":\"%s\",\"symbol\":\"%s\",\"timeframe\":\"%s\",\"direction\":\"%s\",\"entry\":%.10f,\"stop_loss\":%.10f,\"take_profit\":%.10f,\"risk_percent\":%.4f,\"rationale\":\"%s\",\"order_retcode\":\"%s\",\"deal\":\"%s\"}",g_sigState,Esc(g_sigSymbol),Esc(g_sigTf),Esc(g_sigDirection),g_sigEntry,g_sigSL,g_sigTP,g_sigRisk,Esc(g_sigRationale),Esc(g_sigRetcode),Esc(g_sigDeal));}
void Heartbeat(){if(g_terminalToken=="")return;string cfg=StringFormat("{\"strategy\":\"ict-silver-bullet\",\"symbols\":%s,\"timeframes\":%s,\"risk_percent\":%.4f,\"max_daily_loss_percent\":%.4f,\"max_concurrent_positions\":%d}",JsonArray(g_symbols),JsonArray(g_tfs),g_riskPercent,g_dailyLossPercent,g_maxConcurrent);double bal=AccountInfoDouble(ACCOUNT_BALANCE),eq=AccountInfoDouble(ACCOUNT_EQUITY),mar=AccountInfoDouble(ACCOUNT_MARGIN),free=AccountInfoDouble(ACCOUNT_MARGIN_FREE),ml=AccountInfoDouble(ACCOUNT_MARGIN_LEVEL);string b=StringFormat("{\"state\":\"%s\",\"timestamp\":\"%s\",\"terminal_connected\":%s,\"trade_allowed\":%s,\"account\":{\"login\":\"%I64d\",\"server\":\"%s\",\"company\":\"%s\",\"currency\":\"%s\",\"balance\":%.2f,\"equity\":%.2f,\"margin\":%.2f,\"free_margin\":%.2f,\"margin_level\":%.2f,\"leverage\":%d},\"configuration\":%s,\"last_signal\":%s,\"last_error\":\"%s\",\"open_positions\":%s,\"closed_deals\":%s}",StateJson(),IsoUtc(TimeGMT()),TerminalInfoInteger(TERMINAL_CONNECTED)?"true":"false",(MQLInfoInteger(MQL_TRADE_ALLOWED)&&AccountInfoInteger(ACCOUNT_TRADE_ALLOWED))?"true":"false",AccountInfoInteger(ACCOUNT_LOGIN),Esc(AccountInfoString(ACCOUNT_SERVER)),Esc(AccountInfoString(ACCOUNT_COMPANY)),Esc(AccountInfoString(ACCOUNT_CURRENCY)),bal,eq,mar,free,ml,AccountInfoInteger(ACCOUNT_LEVERAGE),cfg,LastSignalJson(),Esc(g_lastError),PositionsJson(),DealsJson());string response=Api("POST","/v1/terminal/heartbeat",b);if(response!="")g_lastHeartbeatAcceptedUtc=TimeGMT();}
int OnInit(){if(StringFind(InpBridgeBaseURL,"https://")!=0||StringFind(InpBridgeBaseURL,".example")>=0||StringFind(InpBridgeBaseURL,"example.com")>=0||StringGetCharacter(InpBridgeBaseURL,StringLen(InpBridgeBaseURL)-1)=='/'){Print("Bridge URL must be a real HTTPS origin without a placeholder host or trailing slash");return INIT_PARAMETERS_INCORRECT;}if(!Finite(InpRiskPercent)||InpRiskPercent<=0||InpRiskPercent>1||!Finite(InpMaxDailyLossPercent)||InpMaxDailyLossPercent<=0||InpMaxDailyLossPercent>100||InpMaxConcurrentPositions<1)return INIT_PARAMETERS_INCORRECT;SplitCsv(InpSymbols,g_symbols);SplitCsv(InpTimeframes,g_tfs);g_riskPercent=InpRiskPercent;g_dailyLossPercent=InpMaxDailyLossPercent;g_maxConcurrent=InpMaxConcurrentPositions;LoadState();if(g_terminalToken=="")Claim();EventSetTimer(MathMax(1,InpPollSeconds));g_lastReason="Initialized; state READY, not trading until START";return INIT_SUCCEEDED;}
void OnDeinit(const int reason){EventKillTimer();}
void OnTimer(){if(g_terminalToken==""){if(g_state!="STOPPED")Claim();return;}ProcessCommands();datetime now=TimeCurrent();if(now-g_lastHeartbeat>=MathMax(5,InpHeartbeatSeconds)){Heartbeat();g_lastHeartbeat=now;}if(g_state=="RUNNING"&&(g_lastHeartbeatAcceptedUtc==0||TimeGMT()-g_lastHeartbeatAcceptedUtc>=HEARTBEAT_STALE_SECONDS)){g_state="STOPPED";g_lastError="No accepted heartbeat within HEARTBEAT_STALE_SECONDS=15; stopped without liquidation";g_lastReason=g_lastError;}if(g_state=="RUNNING"&&now-g_lastScan>=MathMax(1,InpScanSeconds)){Scan();g_lastScan=now;}}
void OnTick(){/* Timed multi-symbol scanner; intentionally no chart-only trade logic. */}
