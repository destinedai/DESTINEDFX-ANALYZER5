#property strict
#property version   "1.00"
#property description "DestinedFX MT5 v1 bridge EA; deterministic closed-candle managed strategies."
#include <Trade/Trade.mqh>
CTrade trade;

input string InpBridgeBaseURL="https://your-bridge.example";
input string InpStrategy="ict-silver-bullet";
input string InpPairingCode="";
input string InpExpectedLogin="";
input string InpExpectedServer="";
input string InpExpectedAccountMode="";
input string InpSymbols="EURUSD";
input string InpTimeframes="M5";
input double InpRiskPercent=0.25;
input double InpMaxDailyLossPercent=2.0;
input int InpMaxConcurrentPositions=2;
input double InpInitialVolume=0.01;
input double InpMaxVolume=0.01;
input bool InpScalingEnabled=false;
input int InpScalingMinClosedTrades=20;
input int InpPollSeconds=5;
input int InpScanSeconds=10;
input int InpHeartbeatSeconds=5;
input int InpNewsFreshnessSeconds=120;
input ulong InpMagic=5271026;
input int InpDeviationPoints=20;
input int InpSlippageAllowancePoints=20;
// Cost configuration is fail-closed: OBSERVED requires representative history;
// CONFIGURED_* requires positive operator-supplied costs and non-empty evidence.
input string InpCostModel="OBSERVED_ROUND_TURN";
input double InpCommissionPerLot=0.0;
input string InpCostEvidence="";

// Deliberately conservative deterministic closed-candle strategy parameters.
#define HEARTBEAT_STALE_SECONDS 15
#define RECENT_BARS 30
#define ATR_PERIOD 14
#define FVG_MAX_AGE 15
#define SWING_LOOKBACK 8
string g_state="READY",g_terminalToken="",g_terminalId="",g_lastSignal="",g_lastReason="Not started",g_lastError="";
string g_symbols[],g_tfs[]; string g_strategy="ict-silver-bullet"; double g_riskPercent=0.25,g_dailyLossPercent=2.0,g_initialVolume=0.01,g_maxVolume=0.01; bool g_scalingEnabled=false; int g_scalingMinClosedTrades=20,g_maxConcurrent=2; string g_sigState="WAIT",g_sigExecutionState="NONE",g_sigSymbol="",g_sigTf="",g_sigDirection="",g_sigRationale="Not scanned",g_sigRetcode="",g_sigDeal="",g_sigOrder="",g_sigPosition=""; double g_sigEntry=0,g_sigSL=0,g_sigTP=0,g_sigRisk=0,g_sigRequestedVolume=0,g_sigExecutedVolume=0,g_sigActualEntry=0; datetime g_sigSubmittedAt=0,g_sigOpenedAt=0; string g_newsStatus="UNKNOWN",g_newsDetail="NEWS UNKNOWN: no authenticated verdict",g_newsSource="",g_newsEvent="",g_newsCurrency=""; long g_newsRetrievedMs=0,g_newsCoverageFromMs=0,g_newsCoverageToMs=0,g_newsEventMs=0,g_newsBlackoutStartMs=0,g_newsBlackoutEndMs=0; int g_cursor=0; datetime g_lastScan=0,g_lastHeartbeat=0,g_lastAuthenticatedBridgeUtc=0,g_lastHeartbeatAcceptedUtc=0; double g_dayStartEquity=0; int g_day=-1; datetime g_liveAuthorizedUntil=0;
string g_processed[],g_ackOutcomes[],g_ackMessages[]; string g_seenSignals[]; string g_lastCommand="";

string Trim(string s){ StringTrimLeft(s); StringTrimRight(s); return s; }
string IsoUtc(datetime value){ MqlDateTime x; TimeToStruct(value,x); return StringFormat("%04d-%02d-%02dT%02d:%02d:%02dZ",x.year,x.mon,x.day,x.hour,x.min,x.sec); }
string BrokerTime(datetime value){if(value<=0)return "UNAVAILABLE";MqlDateTime x;TimeToStruct(value,x);return StringFormat("%04d-%02d-%02d %02d:%02d:%02d (broker server time)",x.year,x.mon,x.day,x.hour,x.min,x.sec);}
int StableHash(string value){long h=0;for(int i=0;i<StringLen(value);i++)h=(h*31+StringGetCharacter(value,i))%2147483647;return (int)h;}
int ServerHash(){return StableHash(AccountInfoString(ACCOUNT_SERVER));}
string DayKey(){ MqlDateTime x; TimeToStruct(TimeCurrent(),x); return StringFormat("DFX_%I64d_%d_%04d%03d",AccountInfoInteger(ACCOUNT_LOGIN),ServerHash(),x.year,x.day_of_year); }
string ObjectAt(string text,int p){ if(p<0||StringGetCharacter(text,p)!='{')return ""; int depth=0;bool quoted=false,esc=false;for(int i=p;i<StringLen(text);i++){ushort ch=StringGetCharacter(text,i);if(quoted){if(esc)esc=false;else if(ch=='\\')esc=true;else if(ch=='\"')quoted=false;}else if(ch=='\"')quoted=true;else if(ch=='{')depth++;else if(ch=='}'&&--depth==0)return StringSubstr(text,p,i-p+1);}return "";}
string ConfigObject(string obj){ int p=StringFind(obj,"\"config\""); if(p<0)return ""; p=StringFind(obj,"{",p); if(p<0)return ""; int depth=0; bool quoted=false,esc=false; for(int i=p;i<StringLen(obj);i++){ushort ch=StringGetCharacter(obj,i); if(quoted){if(esc)esc=false;else if(ch=='\\')esc=true;else if(ch=='\"')quoted=false;}else if(ch=='\"')quoted=true;else if(ch=='{')depth++;else if(ch=='}'&&--depth==0)return StringSubstr(obj,p,i-p+1);} return ""; }
string JArray(string obj,string key){int p=StringFind(obj,"\""+key+"\"");if(p<0)return "";p=StringFind(obj,"[",p);if(p<0)return "";int e=StringFind(obj,"]",p);return e<0?"":StringSubstr(obj,p,e-p+1);}
bool ParseList(string json,string key,string &out[]){string a=JArray(json,key);if(a=="")return false;int l=StringFind(a,"["),e=StringFind(a,"]",l);if(l<0||e<0)return false;string raw=StringSubstr(a,l+1,e-l-1);StringReplace(raw,"\"","");SplitCsv(raw,out);if(ArraySize(out)<1)return false;for(int i=0;i<ArraySize(out);i++)if(out[i]=="")return false;return true;}
bool ValidConfig(string cfg,string &syms[],string &tfs[],double &risk,double &daily,int &concurrent,string &why){string requested=JStr(cfg,"strategy","");if(requested!="smc-confluence-1.0.0"&&requested!="ict-silver-bullet"&&requested!="wyckoff-schematics"&&requested!="supply-and-demand"&&requested!="breakout-momentum"&&requested!="mean-reversion"&&requested!="trend-following"&&requested!="liquidity-stop-hunts"){why="Unsupported managed strategy identifier";return false;}if(!ParseList(cfg,"symbols",syms)||!ParseList(cfg,"timeframes",tfs)){why="symbols and timeframes must be non-empty arrays";return false;}for(int i=0;i<ArraySize(syms);i++){if(StringFind(syms[i]," ")>=0){why="Invalid symbol list";return false;}for(int j=0;j<i;j++)if(syms[i]==syms[j]){why="Duplicate symbol";return false;}}for(int i=0;i<ArraySize(tfs);i++){if(ParseTF(tfs[i])==PERIOD_CURRENT){why="Unsupported timeframe: "+tfs[i];return false;}for(int j=0;j<i;j++)if(tfs[i]==tfs[j]){why="Duplicate timeframe";return false;}}string rs=JStr(cfg,"risk_percent",DoubleToString(InpRiskPercent,4)),ds=JStr(cfg,"max_daily_loss_percent",DoubleToString(InpMaxDailyLossPercent,4)),cs=JStr(cfg,"max_concurrent_positions",IntegerToString(InpMaxConcurrentPositions));risk=StringToDouble(rs);daily=StringToDouble(ds);double cv=StringToDouble(cs);if(!Finite(risk)||risk<=0||risk>1||!Finite(daily)||daily<=0||daily>2.0||!Finite(cv)||cv<1||cv>1000||MathFloor(cv)!=cv){why="Invalid risk or position-limit configuration";return false;}concurrent=(int)cv;double iv=StringToDouble(JStr(cfg,"initial_volume",DoubleToString(InpInitialVolume,4))),mv=StringToDouble(JStr(cfg,"max_volume",DoubleToString(InpMaxVolume,4)));string scale=JStr(cfg,"scaling_enabled",InpScalingEnabled?"true":"false");if(!Finite(iv)||!Finite(mv)||iv<=0||mv<iv||StringToInteger(JStr(cfg,"scaling_min_closed_trades",IntegerToString(InpScalingMinClosedTrades)))<20){why="Invalid volume scaling configuration";return false;}g_initialVolume=iv;g_maxVolume=mv;g_scalingEnabled=(scale=="true");g_scalingMinClosedTrades=(int)StringToInteger(JStr(cfg,"scaling_min_closed_trades",IntegerToString(InpScalingMinClosedTrades)));g_strategy=requested;return true;}
string JsonArray(string &a[]){string r="[";for(int i=0;i<ArraySize(a);i++){if(i)r+=",";r+="\""+Esc(a[i])+"\"";}return r+"]";}
bool MarketReady(string sym,ENUM_TIMEFRAMES tf){ MqlRates rates[]; ArraySetAsSeries(rates,true); if(CopyRates(sym,tf,0,2,rates)<2)return false; return rates[0].time>0 && TimeCurrent()-rates[0].time<=MathMax(120,PeriodSeconds(tf)*3); }
bool Finite(double x){ return MathIsValidNumber(x) && x!=EMPTY_VALUE; }
string Esc(string s){ StringReplace(s,"\\","\\\\"); StringReplace(s,"\"","\\\""); StringReplace(s,"\r",""); StringReplace(s,"\n","\\n"); return s; }
string JStr(string j,string key,string def=""){ string k="\""+key+"\""; int p=StringFind(j,k); if(p<0)return def; p=StringFind(j,":",p+StringLen(k)); if(p<0)return def; p++; while(p<StringLen(j)&&(StringGetCharacter(j,p)==' '||StringGetCharacter(j,p)=='\t'))p++; if(StringGetCharacter(j,p)=='\"'){int e=p+1; while(e<StringLen(j)){if(StringGetCharacter(j,e)=='\"'&&StringGetCharacter(j,e-1)!='\\')break;e++;} return StringSubstr(j,p+1,e-p-1);} int e=p; while(e<StringLen(j)&&StringGetCharacter(j,e)!=','&&StringGetCharacter(j,e)!='}'&&StringGetCharacter(j,e)!=']')e++; return Trim(StringSubstr(j,p,e-p)); }
double JNum(string j,string k,double d){string s=JStr(j,k,""); if(s=="")return d; return StringToDouble(s);}
void RevokeSession(string reason){g_state="STOPPED";g_terminalToken="";g_lastAuthenticatedBridgeUtc=0;g_lastError=reason;g_lastReason="Bridge authorization revoked; fresh pairing code and EA reinitialization required";FileDelete("DestinedFX_terminal_token.txt");}
string Api(string method,string path,string body="",bool auth=true){ string url=InpBridgeBaseURL+path; char data[],result[]; string headers="Content-Type: application/json\r\n"; if(auth&&g_terminalToken!="")headers+="Authorization: Bearer "+g_terminalToken+"\r\n"; if(body!=""){int n=StringToCharArray(body,data,0,WHOLE_ARRAY,CP_UTF8);if(n>0&&data[n-1]==0)ArrayResize(data,n-1);}else ArrayResize(data,0); string respHeaders; ResetLastError(); int code=WebRequest(method,url,headers,10000,data,result,respHeaders); if(auth&&(code==401||code==403)){RevokeSession(StringFormat("Authenticated bridge request returned HTTP %d; session revoked",code));return "";} if(code<200||code>=300){g_lastError=StringFormat("WebRequest %s %s returned %d, error %d",method,path,code,GetLastError()); return "";} if(auth)g_lastAuthenticatedBridgeUtc=TimeGMT(); return CharArrayToString(result,0,-1,CP_UTF8); }
bool NewsClear(string sym){g_newsStatus="UNKNOWN";g_newsDetail="NEWS UNKNOWN: authenticated news provider unavailable";g_newsSource="";g_newsEvent="";g_newsCurrency="";g_newsRetrievedMs=0;g_newsCoverageFromMs=0;g_newsCoverageToMs=0;g_newsEventMs=0;g_newsBlackoutStartMs=0;g_newsBlackoutEndMs=0;string r=Api("GET","/v1/terminal/news-verdict?symbol="+sym);if(r=="")return false;string status=JStr(r,"status","UNKNOWN"),detail=JStr(r,"detail","NEWS UNKNOWN: malformed verdict"),source=JStr(r,"source","");long retrieved=(long)JNum(r,"retrieved_at_ms",0),from=(long)JNum(r,"coverage_from_ms",0),to=(long)JNum(r,"coverage_to_ms",0),eventMs=(long)JNum(r,"event_time_ms",0),before=(long)JNum(r,"blackout_before_seconds",1800),after=(long)JNum(r,"blackout_after_seconds",1800),maxAge=(long)JNum(r,"max_age_seconds",120),effectiveMaxAge=MathMin((long)InpNewsFreshnessSeconds,MathMin((long)120,maxAge>0?maxAge:(long)120)),nowMs=(long)TimeGMT()*1000;g_newsStatus=(status=="HIGH_IMPACT_WINDOW"?status:"UNKNOWN");g_newsDetail=detail;g_newsSource=source;g_newsEvent=JStr(r,"event","");g_newsCurrency=JStr(r,"currency","");g_newsRetrievedMs=retrieved;g_newsCoverageFromMs=from;g_newsCoverageToMs=to;g_newsEventMs=eventMs;g_newsBlackoutStartMs=eventMs-before*1000;g_newsBlackoutEndMs=eventMs+after*1000;if(status!="CLEAR"||source==""||retrieved<=0||from>nowMs||to<nowMs+before*1000||nowMs-retrieved>effectiveMaxAge*1000){return false;}g_newsStatus=status;return true;}
string ReadToken(){int h=FileOpen("DestinedFX_terminal_token.txt",FILE_READ|FILE_TXT|FILE_ANSI); if(h==INVALID_HANDLE)return ""; string s=FileReadString(h);FileClose(h);return Trim(s);}
bool AtomicWrite(string name,string text){string tmp=name+".tmp";int h=FileOpen(tmp,FILE_WRITE|FILE_TXT|FILE_ANSI);if(h==INVALID_HANDLE)return false;FileWriteString(h,text);FileFlush(h);FileClose(h);string bak=name+".bak";FileDelete(bak);if(FileIsExist(name)&&!FileMove(name,0,bak,0)){FileDelete(tmp);return false;}if(!FileMove(tmp,0,name,0)){if(FileIsExist(bak))FileMove(bak,0,name,0);FileDelete(tmp);return false;}FileDelete(bak);return true;}
bool SaveToken(string s){return AtomicWrite("DestinedFX_terminal_token.txt",s);}
string Identity(){return StringFormat("%I64d|%s|%s",AccountInfoInteger(ACCOUNT_LOGIN),AccountInfoString(ACCOUNT_SERVER),TerminalInfoString(TERMINAL_DATA_PATH));}
string BrokerAccountMode(){long mode=AccountInfoInteger(ACCOUNT_TRADE_MODE);if(mode==ACCOUNT_TRADE_MODE_DEMO)return "DEMO";if(mode==ACCOUNT_TRADE_MODE_REAL)return "LIVE";return "";}
bool AccountIdentityMatches(){return InpExpectedLogin!=""&&InpExpectedServer!=""&&(InpExpectedAccountMode=="DEMO"||InpExpectedAccountMode=="LIVE")&&StringFormat("%I64d",AccountInfoInteger(ACCOUNT_LOGIN))==InpExpectedLogin&&AccountInfoString(ACCOUNT_SERVER)==InpExpectedServer&&BrokerAccountMode()==InpExpectedAccountMode;}
string MakeInstanceId(){return StringFormat("%I64d-%d",AccountInfoInteger(ACCOUNT_LOGIN),StableHash(Identity()));}
bool Claim(){ if(InpPairingCode==""){g_lastReason="Pairing code required";return false;}if(!AccountIdentityMatches()){g_lastReason="Actual broker login, exact server, or mode does not match the provisioned profile";return false;} string b=StringFormat("{\"pairing_code\":\"%s\",\"terminal_instance_id\":\"%s\",\"account\":{\"login\":\"%I64d\",\"server\":\"%s\",\"company\":\"%s\",\"currency\":\"%s\",\"account_mode\":\"%s\"}}",Esc(InpPairingCode),Esc(MakeInstanceId()),AccountInfoInteger(ACCOUNT_LOGIN),Esc(AccountInfoString(ACCOUNT_SERVER)),Esc(AccountInfoString(ACCOUNT_COMPANY)),Esc(AccountInfoString(ACCOUNT_CURRENCY)),BrokerAccountMode()); string r=Api("POST","/v1/terminal/claim",b,false); if(r=="")return false; g_terminalId=JStr(r,"terminal_id");g_terminalToken=JStr(r,"terminal_token");if(g_terminalToken=="")return false;if(!SaveToken(g_terminalToken)){g_terminalToken="";g_lastReason="Claim received but terminal-token persistence failed; refusing authenticated operation";return false;}g_lastReason="Terminal claimed";return true; }
ENUM_TIMEFRAMES ParseTF(string s){ if(s=="M1")return PERIOD_M1;if(s=="M5")return PERIOD_M5;if(s=="M15")return PERIOD_M15;if(s=="M30")return PERIOD_M30;if(s=="H1")return PERIOD_H1;if(s=="H4")return PERIOD_H4;if(s=="D1")return PERIOD_D1;return PERIOD_CURRENT; }
void SplitCsv(string src,string &out[]){StringSplit(src,',',out);for(int i=0;i<ArraySize(out);i++)out[i]=Trim(out[i]);}
bool IsKillzone(datetime utc){MqlDateTime x;TimeToStruct(utc,x);int m=x.hour*60+x.min;return (m>=420&&m<540)||(m>=810&&m<930)||(m>=1080&&m<1200);}
int CountPositions(){int n=0;for(int i=PositionsTotal()-1;i>=0;i--){ulong t=PositionGetTicket(i);if(t>0)n++;}return n;}
int CountOurPositions(){int n=0;for(int i=PositionsTotal()-1;i>=0;i--){ulong t=PositionGetTicket(i);if(t>0&&PositionGetInteger(POSITION_MAGIC)==(long)InpMagic)n++;}return n;}
double TodayClosedPnl(){MqlDateTime z;TimeToStruct(TimeCurrent(),z);z.hour=0;z.min=0;z.sec=0;datetime from=StructToTime(z);if(!HistorySelect(from,TimeCurrent()))return 0;double p=0;for(int i=HistoryDealsTotal()-1;i>=0;i--){ulong d=HistoryDealGetTicket(i);if(d>0)p+=HistoryDealGetDouble(d,DEAL_PROFIT)+HistoryDealGetDouble(d,DEAL_COMMISSION)+HistoryDealGetDouble(d,DEAL_SWAP)+HistoryDealGetDouble(d,DEAL_FEE);}return p;}
bool RiskDayOK(){ string key=DayKey(); if(!GlobalVariableCheck(key)){ if(!GlobalVariableSet(key,AccountInfoDouble(ACCOUNT_EQUITY)))return false; } g_dayStartEquity=GlobalVariableGet(key); MqlDateTime z;TimeToStruct(TimeCurrent(),z);g_day=z.day_of_year;double lim=g_dayStartEquity*g_dailyLossPercent/100.0;return g_dayStartEquity>0&&TodayClosedPnl()>-lim&&AccountInfoDouble(ACCOUNT_EQUITY)>g_dayStartEquity-lim; }
string TFLabel(ENUM_TIMEFRAMES tf){return EnumToString(tf);}
string SignalKey(string sym,ENUM_TIMEFRAMES tf,datetime bar,bool bull){return g_strategy+"|"+sym+"|"+TFLabel(tf)+"|"+IntegerToString((int)bar)+"|"+(bull?"B":"S");}
bool Seen(string k){for(int i=0;i<ArraySize(g_seenSignals);i++)if(g_seenSignals[i]==k)return true;return false;}
string SeenFile(){return StringFormat("DestinedFX_seen_%I64d_%d.txt",AccountInfoInteger(ACCOUNT_LOGIN),ServerHash());}
string OrderStateFile(){return StringFormat("DestinedFX_order_%I64d_%d.txt",AccountInfoInteger(ACCOUNT_LOGIN),ServerHash());}
void PersistOrderState(){string row=g_sigOrder+"|"+g_sigPosition+"|"+g_sigSymbol+"|"+g_sigExecutionState+"|"+DoubleToString(g_sigRequestedVolume,8)+"|"+DoubleToString(g_sigExecutedVolume,8)+"|"+DoubleToString(g_sigSL,10)+"|"+DoubleToString(g_sigTP,10)+"|"+DoubleToString(g_sigActualEntry,10)+"|"+(string)g_sigOpenedAt+"|"+(string)g_sigSubmittedAt;AtomicWrite(OrderStateFile(),row);}
void LoadOrderState(){int h=FileOpen(OrderStateFile(),FILE_READ|FILE_TXT|FILE_ANSI);if(h==INVALID_HANDLE)return;string p[];StringSplit(Trim(FileReadString(h)),'|',p);FileClose(h);if(ArraySize(p)>=8&&p[0]!=""){g_sigOrder=p[0];g_sigPosition=p[1];g_sigSymbol=p[2];g_sigExecutionState=p[3];g_sigRequestedVolume=StringToDouble(p[4]);g_sigExecutedVolume=StringToDouble(p[5]);g_sigSL=StringToDouble(p[6]);g_sigTP=StringToDouble(p[7]);if(ArraySize(p)>=11){g_sigActualEntry=StringToDouble(p[8]);g_sigOpenedAt=(datetime)StringToInteger(p[9]);g_sigSubmittedAt=(datetime)StringToInteger(p[10]);}g_sigState="ORDER_ACCEPTED";g_sigRationale="Order state restored; awaiting authoritative broker reconciliation";}}
bool PersistSeen(){string text="";for(int i=0;i<ArraySize(g_seenSignals);i++)text+=g_seenSignals[i]+"\n";return AtomicWrite(SeenFile(),text);}
bool Remember(string k){if(Seen(k))return true;int n=ArraySize(g_seenSignals);ArrayResize(g_seenSignals,n+1);g_seenSignals[n]=k;if(n>=1000){for(int i=1;i<n+1;i++)g_seenSignals[i-1]=g_seenSignals[i];ArrayResize(g_seenSignals,n);}if(!PersistSeen()){ArrayResize(g_seenSignals,n);return false;}return true;}
// A qualifying setup requires a recent three-candle directional FVG, CE proximity, killzone,
// and a sweep/rejection plus displacement candle in the same direction. This is a subset, not full app parity.
bool FindIctSetup(string sym,ENUM_TIMEFRAMES tf,bool &bull,double &entry,double &sl,double &tp,string &why,datetime &signalBar){ MqlRates r[];ArraySetAsSeries(r,true);int got=CopyRates(sym,tf,0,80,r);if(got<50){why="Insufficient bars";return false;} MqlTick q;if(!SymbolInfoTick(sym,q)||!Finite(q.bid)||!Finite(q.ask)||q.bid<=0||q.ask<=q.bid||TimeCurrent()-q.time>120){why="Missing/stale quote";return false;} int ah=iATR(sym,tf,ATR_PERIOD);if(ah==INVALID_HANDLE){why="ATR unavailable";return false;}double ab[];ArraySetAsSeries(ab,true);if(CopyBuffer(ah,0,1,1,ab)!=1){IndicatorRelease(ah);why="ATR unavailable";return false;}double atr=ab[0];IndicatorRelease(ah);if(!Finite(atr)||atr<=0){why="ATR unavailable";return false;} double spread=q.ask-q.bid; int fvg=-1;bool dir=false;double lo=0,hi=0;
 for(int i=1;i<=FVG_MAX_AGE&&i<got-2;i++){ // index i newest closed candle; compare it with two bars older
   if(r[i].low>r[i+2].high){fvg=i;dir=true;lo=r[i+2].high;hi=r[i].low;break;}
   if(r[i].high<r[i+2].low){fvg=i;dir=false;lo=r[i].high;hi=r[i+2].low;break;}
 }
 if(fvg<0){why="No recent directional 3-candle FVG";return false;} double ce=(lo+hi)/2.0,mid=(q.bid+q.ask)/2.0;if(MathAbs(mid-ce)>MathMax(.25*atr,2.0*spread)){why="Price outside FVG CE tolerance";return false;} if(!IsKillzone(TimeGMT())){why="Outside UTC Silver Bullet killzones";return false;}
 // Sweep liquidity in prior swing range, then a directional displacement body >= 0.5 ATR.
 int sw=-1;double swing=0;for(int i=fvg+1;i<MathMin(fvg+SWING_LOOKBACK+1,got-2);i++){if(dir){double prior=r[i+1].low;if(r[i].low<prior&&r[i].close>prior){sw=i;swing=r[i].low;break;}}else{double prior=r[i+1].high;if(r[i].high>prior&&r[i].close<prior){sw=i;swing=r[i].high;break;}}}
 if(sw<0){why="No directional liquidity sweep/rejection";return false;} bool disp=dir?(r[fvg].close>r[fvg].open&&r[fvg].close-r[fvg].open>=.5*atr):(r[fvg].close<r[fvg].open&&r[fvg].open-r[fvg].close>=.5*atr);if(!disp){why="No same-direction displacement candle >= 0.5 ATR";return false;}
 bull=dir;entry=dir?q.ask:q.bid;double point=SymbolInfoDouble(sym,SYMBOL_POINT),tick=SymbolInfoDouble(sym,SYMBOL_TRADE_TICK_SIZE);double minstop=(double)SymbolInfoInteger(sym,SYMBOL_TRADE_STOPS_LEVEL)*point;double buffer=MathMax(.25*atr,MathMax(2*spread,minstop));sl=dir?swing-buffer:swing+buffer;if((dir&&sl>=entry)||(!dir&&sl<=entry)){why="Invalid stop side";return false;} if(MathAbs(entry-sl)<MathMax(minstop,tick)){why="Stop below broker minimum";return false;}double risk=MathAbs(entry-sl);tp=dir?entry+2.0*risk:entry-2.0*risk;signalBar=r[fvg].time;return true; }
bool ClosedRates(string sym,ENUM_TIMEFRAMES tf,MqlRates &r[],int need=80){ArraySetAsSeries(r,true);return CopyRates(sym,tf,1,need,r)>=need;}
double OneBuffer(int handle,int buffer,int shift){double v[];ArraySetAsSeries(v,true);if(handle==INVALID_HANDLE||CopyBuffer(handle,buffer,shift,1,v)!=1){if(handle!=INVALID_HANDLE)IndicatorRelease(handle);return EMPTY_VALUE;}double out=v[0];IndicatorRelease(handle);return out;}
double AtrClosed(string sym,ENUM_TIMEFRAMES tf,int shift=1){return OneBuffer(iATR(sym,tf,ATR_PERIOD),0,shift);}
double EmaClosed(string sym,ENUM_TIMEFRAMES tf,int period,int shift=1){return OneBuffer(iMA(sym,tf,period,0,MODE_EMA,PRICE_CLOSE),0,shift);}
double RsiClosed(string sym,ENUM_TIMEFRAMES tf,int shift=1){return OneBuffer(iRSI(sym,tf,14,PRICE_CLOSE),0,shift);}
bool QuoteSetup(string sym,bool bull,double &entry,double &sl,double &tp,double risk,string why,datetime bar){MqlTick q;if(!SymbolInfoTick(sym,q)||!Finite(q.bid)||!Finite(q.ask)||q.ask<=q.bid||TimeCurrent()-q.time>120){return false;}entry=bull?q.ask:q.bid;double point=SymbolInfoDouble(sym,SYMBOL_POINT),tick=SymbolInfoDouble(sym,SYMBOL_TRADE_TICK_SIZE);if(point<=0||tick<=0||!Finite(risk)||risk<=0)return false;double minstop=SymbolInfoInteger(sym,SYMBOL_TRADE_STOPS_LEVEL)*point;sl=bull?MathFloor(sl/tick)*tick:MathCeil(sl/tick)*tick;sl=NormalizeDouble(sl,(int)SymbolInfoInteger(sym,SYMBOL_DIGITS));double dist=MathAbs(entry-sl);if((bull&&sl>=entry)||(!bull&&sl<=entry)||dist<MathMax(tick,minstop))return false;tp=bull?entry+2.0*dist:entry-2.0*dist;tp=NormalizeDouble(tp,(int)SymbolInfoInteger(sym,SYMBOL_DIGITS));return true;}
bool FindSmcSetup(string sym,ENUM_TIMEFRAMES tf,bool &bull,double &entry,double &sl,double &tp,string &why,datetime &signalBar){MqlRates r[];if(!ClosedRates(sym,tf,r,80)){why="SMC insufficient closed candles";return false;}double atr=AtrClosed(sym,tf);if(!Finite(atr)||atr<=0){why="SMC ATR unavailable";return false;}double hh=-DBL_MAX,ll=DBL_MAX;for(int i=3;i<=24;i++){hh=MathMax(hh,r[i].high);ll=MathMin(ll,r[i].low);}bool up=r[0].close>hh&&r[0].close>r[0].open,down=r[0].close<ll&&r[0].close<r[0].open;if(!up&&!down){why="SMC requires closed-candle BOS";return false;}bull=up;double ob=bull?0:DBL_MAX;for(int i=1;i<=8;i++){if(bull&&r[i].close<r[i].open)ob=r[i].low;if(!bull&&r[i].close>r[i].open)ob=r[i].high;}bool fvg=bull?(r[0].low>r[2].high):(r[0].high<r[2].low);if(!fvg||ob==0||ob==DBL_MAX){why="SMC requires BOS, order block and FVG confluence";return false;}sl=bull?ob-0.25*atr:ob+0.25*atr;signalBar=r[0].time;return QuoteSetup(sym,bull,entry,sl,tp,atr,why,signalBar);}
bool FindWyckoffSetup(string sym,ENUM_TIMEFRAMES tf,bool &bull,double &entry,double &sl,double &tp,string &why,datetime &signalBar){MqlRates r[];if(!ClosedRates(sym,tf,r,60)){why="Wyckoff insufficient closed candles";return false;}double atr=AtrClosed(sym,tf);if(!Finite(atr)||atr<=0){why="Wyckoff ATR unavailable";return false;}double hi=-DBL_MAX,lo=DBL_MAX,vol=0;for(int i=2;i<=30;i++){hi=MathMax(hi,r[i].high);lo=MathMin(lo,r[i].low);vol+=(double)r[i].tick_volume;}double avg=vol/29.0;bool spring=r[0].low<lo&&r[0].close>lo&&r[0].close>r[0].open&&r[0].tick_volume>=avg,utad=r[0].high>hi&&r[0].close<hi&&r[0].close<r[0].open&&r[0].tick_volume>=avg;if(!spring&&!utad){why="Wyckoff requires range extreme spring/UTAD with volume confirmation";return false;}bull=spring;sl=bull?r[0].low-0.25*atr:r[0].high+0.25*atr;signalBar=r[0].time;return QuoteSetup(sym,bull,entry,sl,tp,atr,why,signalBar);}
bool FindSupplyDemandSetup(string sym,ENUM_TIMEFRAMES tf,bool &bull,double &entry,double &sl,double &tp,string &why,datetime &signalBar){MqlRates r[];if(!ClosedRates(sym,tf,r,60)){why="Supply/demand insufficient closed candles";return false;}double atr=AtrClosed(sym,tf);if(!Finite(atr)||atr<=0){why="Supply/demand ATR unavailable";return false;}double bh=MathMax(r[2].high,MathMax(r[3].high,r[4].high)),bl=MathMin(r[2].low,MathMin(r[3].low,r[4].low)),base=bh-bl;bool dbR=base<=0.8*atr&&r[1].close>bh+1.5*atr&&r[0].close>r[0].open;bool rbD=base<=0.8*atr&&r[1].close<bl-1.5*atr&&r[0].close<r[0].open;if(!dbR&&!rbD){why="No fresh rally-base-drop or drop-base-rally departure";return false;}bull=dbR;sl=bull?bl-0.2*atr:bh+0.2*atr;signalBar=r[0].time;return QuoteSetup(sym,bull,entry,sl,tp,atr,why,signalBar);}
bool FindBreakoutSetup(string sym,ENUM_TIMEFRAMES tf,bool &bull,double &entry,double &sl,double &tp,string &why,datetime &signalBar){MqlRates r[];if(!ClosedRates(sym,tf,r,80)){why="Breakout insufficient closed candles";return false;}double atr=AtrClosed(sym,tf);if(!Finite(atr)||atr<=0){why="Breakout ATR unavailable";return false;}double hi=-DBL_MAX,lo=DBL_MAX,atrSum=0,vol=0;for(int i=1;i<=20;i++){hi=MathMax(hi,r[i].high);lo=MathMin(lo,r[i].low);double a=AtrClosed(sym,tf,i+1);if(Finite(a))atrSum+=a;vol+=(double)r[i].tick_volume;}double avgAtr=atrSum/20.0,avgVol=vol/20.0;bool up=r[0].close>hi&&atr>=1.25*avgAtr&&r[0].tick_volume>=1.5*avgVol,down=r[0].close<lo&&atr>=1.25*avgAtr&&r[0].tick_volume>=1.5*avgVol;if(!up&&!down){why="Breakout requires Donchian break, ATR expansion and broker tick-volume confirmation";return false;}bull=up;sl=bull?(hi+lo)/2.0:(hi+lo)/2.0;signalBar=r[0].time;return QuoteSetup(sym,bull,entry,sl,tp,atr,why,signalBar);}
bool FindMeanReversionSetup(string sym,ENUM_TIMEFRAMES tf,bool &bull,double &entry,double &sl,double &tp,string &why,datetime &signalBar){MqlRates r[];if(!ClosedRates(sym,tf,r,50)){why="Mean reversion insufficient closed candles";return false;}double atr=AtrClosed(sym,tf),mid=OneBuffer(iBands(sym,tf,20,0,2.0,PRICE_CLOSE),0,1),upper=OneBuffer(iBands(sym,tf,20,0,2.0,PRICE_CLOSE),1,1),lower=OneBuffer(iBands(sym,tf,20,0,2.0,PRICE_CLOSE),2,1),rsi=RsiClosed(sym,tf);if(!Finite(atr)||!Finite(mid)||!Finite(upper)||!Finite(lower)||!Finite(rsi)||atr<=0){why="Mean reversion indicator data unavailable";return false;}double lw=MathMin(r[0].open,r[0].close)-r[0].low,uw=r[0].high-MathMax(r[0].open,r[0].close);bool up=r[0].low<=lower&&rsi<30&&lw>=0.5*(r[0].high-r[0].low)&&r[0].close>r[0].open,down=r[0].high>=upper&&rsi>70&&uw>=0.5*(r[0].high-r[0].low)&&r[0].close<r[0].open;if(!up&&!down){why="Mean reversion requires BB extreme, RSI and rejection";return false;}bull=up;sl=bull?r[0].low-0.2*atr:r[0].high+0.2*atr;signalBar=r[0].time;return QuoteSetup(sym,bull,entry,sl,tp,atr,why,signalBar);}
bool FindTrendSetup(string sym,ENUM_TIMEFRAMES tf,bool &bull,double &entry,double &sl,double &tp,string &why,datetime &signalBar){MqlRates r[];if(!ClosedRates(sym,tf,r,60)){why="Trend following insufficient closed candles";return false;}double e20=EmaClosed(sym,tf,20),e50=EmaClosed(sym,tf,50),e200=EmaClosed(sym,tf,200),atr=AtrClosed(sym,tf);if(!Finite(e20)||!Finite(e50)||!Finite(e200)||!Finite(atr)){why="Trend EMA data unavailable";return false;}bool up=e20>e50&&e50>e200&&r[1].low<=e20&&r[0].close>r[0].open&&r[0].close>e20,down=e20<e50&&e50<e200&&r[1].high>=e20&&r[0].close<r[0].open&&r[0].close<e20;if(!up&&!down){why="Trend following requires EMA20/50/200 alignment, pullback and continuation";return false;}bull=up;sl=bull?e50-0.25*atr:e50+0.25*atr;signalBar=r[0].time;return QuoteSetup(sym,bull,entry,sl,tp,atr,why,signalBar);}
bool FindLiquiditySetup(string sym,ENUM_TIMEFRAMES tf,bool &bull,double &entry,double &sl,double &tp,string &why,datetime &signalBar){MqlRates r[];if(!ClosedRates(sym,tf,r,60)){why="Liquidity setup insufficient closed candles";return false;}double atr=AtrClosed(sym,tf);if(!Finite(atr)){why="Liquidity ATR unavailable";return false;}bool lowPool=false,highPool=false;double poolLow=0,poolHigh=0;for(int i=3;i<=25;i++)for(int j=i+1;j<=30;j++){if(MathAbs(r[i].low-r[j].low)<=0.2*atr){lowPool=true;poolLow=MathMax(r[i].low,r[j].low);}if(MathAbs(r[i].high-r[j].high)<=0.2*atr){highPool=true;poolHigh=MathMin(r[i].high,r[j].high);}}bool up=lowPool&&r[0].low<poolLow&&r[0].close>poolLow&&r[0].close>r[0].open,down=highPool&&r[0].high>poolHigh&&r[0].close<poolHigh&&r[0].close<r[0].open;if(!up&&!down){why="Liquidity stop hunt requires equal pool sweep and rejection";return false;}bull=up;sl=bull?r[0].low-0.2*atr:r[0].high+0.2*atr;signalBar=r[0].time;return QuoteSetup(sym,bull,entry,sl,tp,atr,why,signalBar);}
bool FindStrategySetup(string sym,ENUM_TIMEFRAMES tf,bool &bull,double &entry,double &sl,double &tp,string &why,datetime &signalBar){if(g_strategy=="smc-confluence-1.0.0")return FindSmcSetup(sym,tf,bull,entry,sl,tp,why,signalBar);if(g_strategy=="ict-silver-bullet")return FindIctSetup(sym,tf,bull,entry,sl,tp,why,signalBar);if(g_strategy=="wyckoff-schematics")return FindWyckoffSetup(sym,tf,bull,entry,sl,tp,why,signalBar);if(g_strategy=="supply-and-demand")return FindSupplyDemandSetup(sym,tf,bull,entry,sl,tp,why,signalBar);if(g_strategy=="breakout-momentum")return FindBreakoutSetup(sym,tf,bull,entry,sl,tp,why,signalBar);if(g_strategy=="mean-reversion")return FindMeanReversionSetup(sym,tf,bull,entry,sl,tp,why,signalBar);if(g_strategy=="trend-following")return FindTrendSetup(sym,tf,bull,entry,sl,tp,why,signalBar);if(g_strategy=="liquidity-stop-hunts")return FindLiquiditySetup(sym,tf,bull,entry,sl,tp,why,signalBar);why="Unsupported managed strategy";return false;}

int VolDigits(double step){int d=0;while(d<8&&MathAbs(step-NormalizeDouble(step,d))>1e-9)d++;return d;}
double ObservedCommissionPerLot(string sym){if(!HistorySelect(TimeCurrent()-86400*30,TimeCurrent()))return -1;ulong ids[];double entered[],exited[],charges[];bool hasEntry[],hasExit[],invalid[];int total=HistoryDealsTotal();for(int i=total-1,seen=0;i>=0&&seen<5000;i--,seen++){ulong d=HistoryDealGetTicket(i);if(!d||HistoryDealGetString(d,DEAL_SYMBOL)!=sym||(ulong)HistoryDealGetInteger(d,DEAL_MAGIC)!=(ulong)InpMagic)continue;long e=HistoryDealGetInteger(d,DEAL_ENTRY);if(e!=DEAL_ENTRY_IN&&e!=DEAL_ENTRY_OUT&&e!=DEAL_ENTRY_OUT_BY&&e!=DEAL_ENTRY_INOUT)continue;ulong pid=(ulong)HistoryDealGetInteger(d,DEAL_POSITION_ID);if(pid==0)continue;int k=-1;for(int j=0;j<ArraySize(ids);j++)if(ids[j]==pid){k=j;break;}if(k<0){k=ArraySize(ids);ArrayResize(ids,k+1);ArrayResize(entered,k+1);ArrayResize(exited,k+1);ArrayResize(charges,k+1);ArrayResize(hasEntry,k+1);ArrayResize(hasExit,k+1);ArrayResize(invalid,k+1);ids[k]=pid;entered[k]=0;exited[k]=0;charges[k]=0;hasEntry[k]=false;hasExit[k]=false;invalid[k]=false;}double v=HistoryDealGetDouble(d,DEAL_VOLUME),commission=HistoryDealGetDouble(d,DEAL_COMMISSION),fee=HistoryDealGetDouble(d,DEAL_FEE),swap=HistoryDealGetDouble(d,DEAL_SWAP);if(!Finite(v)||v<=0||!Finite(commission)||!Finite(fee)||!Finite(swap)){invalid[k]=true;continue;}if(e==DEAL_ENTRY_IN){hasEntry[k]=true;entered[k]+=v;}else if(e==DEAL_ENTRY_OUT||e==DEAL_ENTRY_OUT_BY){hasExit[k]=true;exited[k]+=v;}else{invalid[k]=true;continue;}charges[k]+=MathAbs(commission)+MathAbs(fee)+MathAbs(swap);}double totalCharges=0,totalEntered=0;int samples=0;for(int k=0;k<ArraySize(ids);k++){if(invalid[k]||!hasEntry[k]||!hasExit[k]||entered[k]<=0||MathAbs(exited[k]-entered[k])>MathMax(0.0000001,entered[k]*0.00001))continue;bool open=false;for(int j=PositionsTotal()-1;j>=0;j--){ulong t=PositionGetTicket(j);if(t>0&&(ulong)PositionGetInteger(POSITION_IDENTIFIER)==ids[k]){open=true;break;}}if(open)continue;if(!Finite(charges[k])||charges[k]<=0)continue;totalCharges+=charges[k];totalEntered+=entered[k];samples++;}return samples>=3&&totalEntered>0&&totalCharges>0?totalCharges/totalEntered:-1;}
bool ManagedClosedPosition(ulong pid){if(pid==0||!HistorySelect(TimeCurrent()-86400*90,TimeCurrent()))return false;double entered=0,exited=0;bool hasEntry=false,hasExit=false;for(int i=HistoryDealsTotal()-1;i>=0;i--){ulong d=HistoryDealGetTicket(i);if(!d||(ulong)HistoryDealGetInteger(d,DEAL_POSITION_ID)!=pid)continue;if((ulong)HistoryDealGetInteger(d,DEAL_MAGIC)!=(ulong)InpMagic)return false;long e=HistoryDealGetInteger(d,DEAL_ENTRY);double v=HistoryDealGetDouble(d,DEAL_VOLUME);if(v<=0||!Finite(v))return false;if(e==DEAL_ENTRY_IN){hasEntry=true;entered+=v;}else if(e==DEAL_ENTRY_OUT||e==DEAL_ENTRY_OUT_BY){hasExit=true;exited+=v;}else if(e==DEAL_ENTRY_INOUT){return false;}}for(int j=PositionsTotal()-1;j>=0;j--){ulong t=PositionGetTicket(j);if(t>0&&(ulong)PositionGetInteger(POSITION_IDENTIFIER)==pid)return false;}return hasEntry&&hasExit&&entered>0&&MathAbs(exited-entered)<=MathMax(0.0000001,entered*0.00001);}
int ReconciledClosedTrades(){if(!HistorySelect(TimeCurrent()-86400*90,TimeCurrent()))return 0;ulong ids[];int count=0;for(int i=HistoryDealsTotal()-1;i>=0;i--){ulong d=HistoryDealGetTicket(i);if(!d||(ulong)HistoryDealGetInteger(d,DEAL_MAGIC)!=(ulong)InpMagic)continue;ulong pid=(ulong)HistoryDealGetInteger(d,DEAL_POSITION_ID);if(!ManagedClosedPosition(pid))continue;bool seen=false;for(int j=0;j<count;j++)if(ids[j]==pid)seen=true;if(!seen){ArrayResize(ids,count+1);ids[count++]=pid;}}return count;}
double ReconciledClosedNet(){if(!HistorySelect(TimeCurrent()-86400*90,TimeCurrent()))return 0;ulong ids[];int count=0;for(int i=HistoryDealsTotal()-1;i>=0;i--){ulong d=HistoryDealGetTicket(i);if(!d||(ulong)HistoryDealGetInteger(d,DEAL_MAGIC)!=(ulong)InpMagic)continue;ulong pid=(ulong)HistoryDealGetInteger(d,DEAL_POSITION_ID);if(!ManagedClosedPosition(pid))continue;bool seen=false;for(int j=0;j<count;j++)if(ids[j]==pid)seen=true;if(!seen){ArrayResize(ids,count+1);ids[count++]=pid;}}double net=0;for(int i=HistoryDealsTotal()-1;i>=0;i--){ulong d=HistoryDealGetTicket(i);if(!d||(ulong)HistoryDealGetInteger(d,DEAL_MAGIC)!=(ulong)InpMagic)continue;ulong pid=(ulong)HistoryDealGetInteger(d,DEAL_POSITION_ID);bool qualifying=false;for(int j=0;j<count;j++)if(ids[j]==pid)qualifying=true;if(qualifying)net+=HistoryDealGetDouble(d,DEAL_PROFIT)+HistoryDealGetDouble(d,DEAL_COMMISSION)+HistoryDealGetDouble(d,DEAL_SWAP)+HistoryDealGetDouble(d,DEAL_FEE);}return net;}
bool ScalingEligible(){return g_scalingEnabled&&AccountIdentityMatches()&&ReconciledClosedTrades()>=g_scalingMinClosedTrades&&ReconciledClosedNet()>0&&RiskDayOK();}
double VerifiedCommissionPerLot(string sym){if(InpCostModel=="CONFIGURED_ROUND_TURN"||InpCostModel=="CONFIGURED_PER_SIDE"){if(!Finite(InpCommissionPerLot)||InpCommissionPerLot<=0||StringLen(Trim(InpCostEvidence))<8)return -1;return InpCostModel=="CONFIGURED_PER_SIDE"?2.0*InpCommissionPerLot:InpCommissionPerLot;}if(InpCostModel=="ZERO_COMMISSION_SPREAD_ONLY"){if(!Finite(InpCommissionPerLot)||InpCommissionPerLot!=0.0||StringLen(Trim(InpCostEvidence))<8)return -1;return 0.0;}if(InpCostModel=="OBSERVED_ROUND_TURN")return ObservedCommissionPerLot(sym);return -1;}
bool CostConfigurationValid(){if(InpCostModel=="OBSERVED_ROUND_TURN")return InpCommissionPerLot==0.0&&StringLen(Trim(InpCostEvidence))==0;if(InpCostModel=="ZERO_COMMISSION_SPREAD_ONLY")return Finite(InpCommissionPerLot)&&InpCommissionPerLot==0.0&&StringLen(Trim(InpCostEvidence))>=8;if(InpCostModel=="CONFIGURED_ROUND_TURN"||InpCostModel=="CONFIGURED_PER_SIDE")return Finite(InpCommissionPerLot)&&InpCommissionPerLot>0&&StringLen(Trim(InpCostEvidence))>=8;return false;}
bool Place(string sym,ENUM_TIMEFRAMES tf,bool bull,double entry,double sl,double tp,datetime bt,string key){if(!AccountIdentityMatches()){g_state="STOPPED";g_lastError="Actual broker identity or account mode no longer matches the provisioned profile";g_lastReason=g_lastError;return false;}if(g_state!="RUNNING"||g_lastAuthenticatedBridgeUtc==0||TimeGMT()-g_lastAuthenticatedBridgeUtc>=HEARTBEAT_STALE_SECONDS){g_state="STOPPED";g_lastError="No authenticated bridge response within HEARTBEAT_STALE_SECONDS=15; stopped without liquidation";g_lastReason=g_lastError;return false;}if(InpExpectedAccountMode=="LIVE"&&(g_liveAuthorizedUntil<=0||TimeGMT()>=g_liveAuthorizedUntil)){g_state="STOPPED";g_lastError="LIVE authorization is absent or expired at the order boundary";g_lastReason=g_lastError;return false;}if(!TerminalInfoInteger(TERMINAL_CONNECTED)||!MQLInfoInteger(MQL_TRADE_ALLOWED)||!AccountInfoInteger(ACCOUNT_TRADE_ALLOWED)){g_lastReason="Terminal/broker trade permission unavailable";return false;}if(!RiskDayOK()||CountOurPositions()>=g_maxConcurrent){g_lastReason="Daily loss or concurrent position limit";return false;}if(!SymbolSelect(sym,true)){g_lastReason="Symbol unavailable";return false;}MqlTick q;if(!SymbolInfoTick(sym,q)||q.bid<=0||q.ask<=q.bid||TimeCurrent()-q.time>120){g_lastReason="Quote stale before order";return false;}double point=SymbolInfoDouble(sym,SYMBOL_POINT),tick=SymbolInfoDouble(sym,SYMBOL_TRADE_TICK_SIZE),stopLevel=SymbolInfoInteger(sym,SYMBOL_TRADE_STOPS_LEVEL)*point;if(point<=0||tick<=0){g_lastReason="Invalid symbol tick size";return false;}entry=bull?q.ask:q.bid; sl=bull?MathFloor(sl/tick)*tick:MathCeil(sl/tick)*tick; tp=bull?MathCeil(tp/tick)*tick:MathFloor(tp/tick)*tick;sl=NormalizeDouble(sl,(int)SymbolInfoInteger(sym,SYMBOL_DIGITS));tp=NormalizeDouble(tp,(int)SymbolInfoInteger(sym,SYMBOL_DIGITS));if((bull&&(sl>=entry||tp<=entry))||(!bull&&(sl<=entry||tp>=entry))||MathAbs(entry-sl)<MathMax(tick,stopLevel)){g_lastReason="Fresh quote violates stop/target side, minimum stop, or 2R";return false;}double base=MathMin(AccountInfoDouble(ACCOUNT_BALANCE),AccountInfoDouble(ACCOUNT_EQUITY));if(!Finite(base)||base<=0||g_riskPercent<=0||g_riskPercent>1.0){g_lastReason="Invalid account/risk configuration";return false;}double loss=0;if(!OrderCalcProfit(bull?ORDER_TYPE_BUY:ORDER_TYPE_SELL,sym,1.0,entry,sl,loss)||!Finite(loss)||loss>=0){g_lastReason="Risk calculation failed";return false;}double commissionLot=VerifiedCommissionPerLot(sym);bool zeroCommissionModel=(InpCostModel=="ZERO_COMMISSION_SPREAD_ONLY");if(!Finite(commissionLot)||commissionLot<0||(!zeroCommissionModel&&commissionLot<=0)){g_lastReason="No verified broker commission cost for this symbol/account; trade blocked rather than assuming zero";return false;}ENUM_ORDER_TYPE orderType=bull?ORDER_TYPE_BUY:ORDER_TYPE_SELL;double spreadValue=0;if(!OrderCalcProfit(orderType,sym,1.0,bull?q.bid:q.ask,bull?q.ask:q.bid,spreadValue)||!Finite(spreadValue)||spreadValue<=0){g_lastReason="Unable to calculate live spread cost in account currency; trade blocked";return false;}double spreadCostPerLot=MathAbs(spreadValue);double conversionDistance=MathMin(1.0,entry*0.1);if(conversionDistance<tick)conversionDistance=tick;if(conversionDistance>=entry)conversionDistance=entry*0.5;double unitProfit=0;if(!Finite(conversionDistance)||conversionDistance<=0||!OrderCalcProfit(orderType,sym,1.0,entry,bull?entry+conversionDistance:entry-conversionDistance,unitProfit)||!Finite(unitProfit)||unitProfit<=0){g_lastReason="Unable to convert verified cost into target price";return false;}double adversePrice=entry+(bull?1.0:-1.0)*InpSlippageAllowancePoints*point,slippageOneLeg=0;if(!OrderCalcProfit(orderType,sym,1.0,entry,adversePrice,slippageOneLeg)||!Finite(slippageOneLeg)||slippageOneLeg<=0){g_lastReason="Unable to calculate conservative slippage allowance";return false;}double slippageAllowancePerLot=2.0*MathAbs(slippageOneLeg),costPerLot=commissionLot+spreadCostPerLot+slippageAllowancePerLot;double requiredGrossReward=2.0*MathAbs(loss)+3.0*costPerLot,requiredTargetDistance=requiredGrossReward*conversionDistance/MathAbs(unitProfit);tp=bull?entry+requiredTargetDistance:entry-requiredTargetDistance;tp=bull?MathCeil(tp/tick)*tick:MathFloor(tp/tick)*tick;tp=NormalizeDouble(tp,(int)SymbolInfoInteger(sym,SYMBOL_DIGITS));if((bull&&tp<=entry)||(!bull&&tp>=entry)||MathAbs(tp-entry)<MathMax(tick,stopLevel)){g_lastReason="Cost-adjusted target is not broker-valid";return false;}double budget=base*g_riskPercent/100.0,step=SymbolInfoDouble(sym,SYMBOL_VOLUME_STEP),vmin=SymbolInfoDouble(sym,SYMBOL_VOLUME_MIN),vmax=SymbolInfoDouble(sym,SYMBOL_VOLUME_MAX),raw=budget/(MathAbs(loss)+costPerLot);double volumeCap=ScalingEligible()?g_maxVolume:g_initialVolume;/* legacy safety invariant: g_scalingEnabled?g_maxVolume:g_initialVolume; actual scaling is additionally gated by ScalingEligible(). */raw=MathMin(raw,volumeCap);if(step<=0||vmin<=0||raw<vmin){g_lastReason="Risk size below broker minimum";return false;}double vol=NormalizeDouble(MathMin(vmax,MathFloor(raw/step+1e-10)*step),VolDigits(step));double checked=0,reward=0;if(vol<vmin||!OrderCalcProfit(orderType,sym,vol,entry,sl,checked)||!OrderCalcProfit(orderType,sym,vol,entry,tp,reward)){g_lastReason="Fresh-price broker risk/reward calculation failed";return false;}double netRisk=MathAbs(checked)+costPerLot*vol,netReward=reward-costPerLot*vol;if(netRisk>budget+0.01||netReward<=0||netReward+0.01<2.0*netRisk){g_lastReason="Fresh-price risk, verified round-turn costs, slippage allowance, or net 2R validation failed";return false;}double margin=0;if(!OrderCalcMargin(bull?ORDER_TYPE_BUY:ORDER_TYPE_SELL,sym,vol,entry,margin)||AccountInfoDouble(ACCOUNT_MARGIN_FREE)<margin*1.10){g_lastReason="Insufficient margin";return false;}if(!RiskDayOK()){g_lastReason="Daily loss cap changed before order";return false;}if(!Remember(key)){g_lastReason="Signal deduplication state could not be persisted; order blocked";return false;}if(!NewsClear(sym)){g_lastReason=g_newsDetail;g_sigState="REJECTED";g_sigExecutionState="NEWS_BLOCKED";g_sigRationale=g_newsDetail;return false;}trade.SetExpertMagicNumber(InpMagic);trade.SetDeviationInPoints(InpDeviationPoints);trade.SetTypeFillingBySymbol(sym);g_sigSubmittedAt=TimeGMT();bool ok=bull?trade.Buy(vol,sym,0,sl,tp,"DFX "+g_strategy):trade.Sell(vol,sym,0,sl,tp,"DFX "+g_strategy);uint rc=trade.ResultRetcode();ulong deal=trade.ResultDeal();ulong order=trade.ResultOrder();if(!ok||(rc!=TRADE_RETCODE_DONE&&rc!=TRADE_RETCODE_PLACED&&rc!=TRADE_RETCODE_DONE_PARTIAL)||((rc==TRADE_RETCODE_DONE||rc==TRADE_RETCODE_DONE_PARTIAL)&&deal==0)){g_lastError=StringFormat("Order not verified retcode %u deal %I64u: %s",rc,deal,trade.ResultRetcodeDescription());g_lastReason=g_lastError;return false;}g_lastSignal=key;g_sigState="ORDER_ACCEPTED";g_sigExecutionState=rc==TRADE_RETCODE_PLACED?"ORDER_SUBMITTED":(rc==TRADE_RETCODE_DONE_PARTIAL?"PARTIALLY_FILLED":"FILLED");g_sigRetcode=IntegerToString((int)rc);g_sigDeal=(string)deal;g_sigOrder=(string)order;g_sigRequestedVolume=vol;g_sigExecutedVolume=deal>0?HistoryDealGetDouble(deal,DEAL_VOLUME):0;g_lastReason="Order accepted for processing, retcode="+IntegerToString((int)rc);g_sigRationale=(rc==TRADE_RETCODE_PLACED?"Order submitted; broker fill not confirmed":(rc==TRADE_RETCODE_DONE_PARTIAL?"Partial broker fill confirmed":"Broker fill confirmed"));PersistOrderState();return true;}
void SetWait(string sym,string tf,string why){g_sigState="WAIT";g_sigExecutionState="NONE";g_sigSymbol=sym;g_sigTf=tf;g_sigDirection="";g_sigEntry=0;g_sigSL=0;g_sigTP=0;g_sigRisk=g_riskPercent;g_sigRequestedVolume=0;g_sigExecutedVolume=0;g_sigRationale=why;g_sigRetcode="";g_sigDeal="";g_sigOrder="";g_sigPosition="";g_lastReason=why;}
void Scan(){if(g_state!="RUNNING"||g_lastHeartbeatAcceptedUtc==0||TimeGMT()-g_lastHeartbeatAcceptedUtc>=HEARTBEAT_STALE_SECONDS)return;if(g_sigOrder!=""&&g_sigExecutionState!="CLOSED_DEAL_RECONCILED"&&g_sigExecutionState!="CANCELLED_OR_EXPIRED"&&g_sigExecutionState!="REJECTED"&&g_sigExecutionState!="UNKNOWN_REQUIRES_RECONCILIATION"&&g_sigExecutionState!="FILLED_POSITION_NOT_FOUND")return;SetWait("","","No eligible setup in active scan list");for(int s=0;s<ArraySize(g_symbols);s++){string sym=g_symbols[s];if(!SymbolSelect(sym,true)){SetWait(sym,"","Symbol unavailable");continue;}for(int t=0;t<ArraySize(g_tfs);t++){ENUM_TIMEFRAMES tf=ParseTF(g_tfs[t]);string why;bool bull;double en,sl,tp;datetime bt;if(!FindStrategySetup(sym,tf,bull,en,sl,tp,why,bt)){SetWait(sym,g_tfs[t],why);continue;}string key=SignalKey(sym,tf,bt,bull);g_sigSymbol=sym;g_sigTf=g_tfs[t];g_sigDirection=bull?"BUY":"SELL";g_sigEntry=en;g_sigActualEntry=0;g_sigSubmittedAt=0;g_sigOpenedAt=0;g_sigSL=sl;g_sigTP=tp;g_sigRisk=g_riskPercent;g_sigRationale="Eligible "+g_strategy+" closed-candle setup";if(Seen(key)){SetWait(sym,g_tfs[t],"Duplicate signal suppressed");continue;}bool accepted=Place(sym,tf,bull,en,sl,tp,bt,key);if(!accepted){g_sigState="REJECTED";g_sigRationale=g_lastReason;g_sigRetcode=IntegerToString((int)trade.ResultRetcode());g_sigDeal=(string)trade.ResultDeal();}}}}
void Ack(string id,string outcome,string msg){string b=StringFormat("{\"outcome\":\"%s\",\"state\":\"%s\",\"message\":\"%s\"}",outcome,g_state,Esc(msg));Api("POST","/v1/terminal/commands/"+id+"/ack",b);}
void SaveCursor(){AtomicWrite("DestinedFX_cursor.txt",IntegerToString(g_cursor));}
void PersistProcessed(){string text="";for(int i=0;i<ArraySize(g_processed);i++)text+=g_processed[i]+"|"+g_ackOutcomes[i]+"|"+g_ackMessages[i]+"\n";AtomicWrite("DestinedFX_processed.txt",text);}
void LoadState(){g_terminalToken=ReadToken();int h=FileOpen("DestinedFX_cursor.txt",FILE_READ|FILE_TXT);if(h!=INVALID_HANDLE){g_cursor=(int)StringToInteger(FileReadString(h));FileClose(h);}h=FileOpen("DestinedFX_processed.txt",FILE_READ|FILE_TXT|FILE_ANSI);if(h!=INVALID_HANDLE){while(!FileIsEnding(h)&&ArraySize(g_processed)<1000){string row=Trim(FileReadString(h)),parts[];if(row=="")continue;StringSplit(row,'|',parts);int n=ArraySize(g_processed);ArrayResize(g_processed,n+1);ArrayResize(g_ackOutcomes,n+1);ArrayResize(g_ackMessages,n+1);g_processed[n]=parts[0];g_ackOutcomes[n]=ArraySize(parts)>1?parts[1]:"REJECTED";g_ackMessages[n]=ArraySize(parts)>2?parts[2]:"Previous outcome unavailable; not re-applied";}FileClose(h);}h=FileOpen(SeenFile(),FILE_READ|FILE_TXT|FILE_ANSI);if(h!=INVALID_HANDLE){while(!FileIsEnding(h)&&ArraySize(g_seenSignals)<1000){string k=Trim(FileReadString(h));if(k!=""&&StringFind(k,"|")>0){int n=ArraySize(g_seenSignals);ArrayResize(g_seenSignals,n+1);g_seenSignals[n]=k;}}FileClose(h);}LoadOrderState();g_state="READY";}
void ProcessCommands(){if(g_terminalToken=="")return;string r=Api("GET","/v1/terminal/commands?cursor="+IntegerToString(g_cursor));if(r=="")return;int c=(int)JNum(r,"cursor",g_cursor); // parse documented command objects with bounded extraction
 int pos=StringFind(r,"\"commands\"");if(pos>=0){pos=StringFind(r,"{",pos);while(pos>=0){string obj=ObjectAt(r,pos);if(obj=="")break;int end=pos+StringLen(obj)-1;string id=JStr(obj,"id"),action=JStr(obj,"action");if(id=="")break;bool done=false;for(int i=0;i<ArraySize(g_processed);i++)if(g_processed[i]==id)done=true;if(done){for(int ai=0;ai<ArraySize(g_processed);ai++)if(g_processed[ai]==id)Ack(id,g_ackOutcomes[ai],g_ackMessages[ai]);}else{string outcome="APPLIED",msg="Command applied";if(action=="START"){string cfgobj=ConfigObject(obj),why;string syms[],tfs[];double risk,daily;int concurrent;if(!ValidConfig(cfgobj,syms,tfs,risk,daily,concurrent,why)){g_state="STOPPED";outcome="REJECTED";msg=why;}else if(!AccountIdentityMatches()||!TerminalInfoInteger(TERMINAL_CONNECTED)||!MQLInfoInteger(MQL_TRADE_ALLOWED)||!AccountInfoInteger(ACCOUNT_TRADE_ALLOWED)){g_state="STOPPED";outcome="REJECTED";msg="Terminal connectivity/trade permission check failed";}else if(AccountInfoDouble(ACCOUNT_BALANCE)<=0||AccountInfoDouble(ACCOUNT_EQUITY)<=0){g_state="STOPPED";outcome="REJECTED";msg="Invalid account snapshot";}else{bool ready=true;for(int si=0;si<ArraySize(syms);si++){if(!SymbolSelect(syms[si],true))ready=false;for(int ti=0;ti<ArraySize(tfs);ti++){ENUM_TIMEFRAMES mtf=ParseTF(tfs[ti]);MqlRates hr[];ArraySetAsSeries(hr,true);MqlTick tq;if(mtf==PERIOD_CURRENT||!MarketReady(syms[si],mtf)||CopyRates(syms[si],mtf,0,80,hr)<50||!SymbolInfoTick(syms[si],tq)||tq.bid<=0||tq.ask<=tq.bid||TimeCurrent()-tq.time>120)ready=false;}}if(!ready){g_state="STOPPED";outcome="REJECTED";msg="Requested symbols/timeframes lack fresh quotes or sufficient history";}else{ArrayCopy(g_symbols,syms);ArrayCopy(g_tfs,tfs);g_riskPercent=risk;g_dailyLossPercent=daily;g_maxConcurrent=concurrent;g_state="RUNNING";msg="Started with validated runtime configuration";}}}else if(action=="STOP"||action=="EMERGENCY_STOP"){g_state="STOPPED";msg="New entries stopped; open positions and broker SL/TP left untouched";}else if(action=="PAUSE"){g_state="PAUSED";msg="Paused; open positions untouched";}else if(action=="RESUME"){if(AccountIdentityMatches()&&TerminalInfoInteger(TERMINAL_CONNECTED)&&MQLInfoInteger(MQL_TRADE_ALLOWED)&&AccountInfoInteger(ACCOUNT_TRADE_ALLOWED)){g_state="RUNNING";msg="Resumed";}else{outcome="REJECTED";msg="Terminal checks failed";}}else{outcome="REJECTED";msg="Unknown action";}int n=ArraySize(g_processed);ArrayResize(g_processed,n+1);ArrayResize(g_ackOutcomes,n+1);ArrayResize(g_ackMessages,n+1);g_processed[n]=id;g_ackOutcomes[n]=outcome;g_ackMessages[n]=msg;PersistProcessed();Ack(id,outcome,msg);}pos=StringFind(r,"{",end+1);if(pos<0)break;}}
 if(c>g_cursor){g_cursor=c;SaveCursor();}}
void ReconcileOrder(){if(g_sigOrder==""||g_sigRequestedVolume<=0)return;ulong order=(ulong)StringToInteger(g_sigOrder),position=0;double executed=0,weightedEntry=0;datetime openedAt=0;bool closed=false;if(HistorySelect(TimeCurrent()-86400*30,TimeCurrent())){for(int i=HistoryDealsTotal()-1;i>=0;i--){ulong d=HistoryDealGetTicket(i);if(!d||(ulong)HistoryDealGetInteger(d,DEAL_MAGIC)!=(ulong)InpMagic||HistoryDealGetString(d,DEAL_SYMBOL)!=g_sigSymbol)continue;ulong dealOrder=(ulong)HistoryDealGetInteger(d,DEAL_ORDER);ulong dealPosition=(ulong)HistoryDealGetInteger(d,DEAL_POSITION_ID);if(dealOrder!=order&&!(g_sigPosition!=""&&dealPosition==(ulong)StringToInteger(g_sigPosition)))continue;long entry=HistoryDealGetInteger(d,DEAL_ENTRY);if(entry==DEAL_ENTRY_IN){double dv=HistoryDealGetDouble(d,DEAL_VOLUME),dp=HistoryDealGetDouble(d,DEAL_PRICE);if(!Finite(dv)||dv<=0||!Finite(dp)||dp<=0)continue;executed+=dv;weightedEntry+=dp*dv;if(position==0)position=dealPosition;datetime dt=(datetime)HistoryDealGetInteger(d,DEAL_TIME);if(openedAt==0||dt<openedAt)openedAt=dt;}else if(entry==DEAL_ENTRY_INOUT){closed=true;}if(entry==DEAL_ENTRY_OUT||entry==DEAL_ENTRY_OUT_BY)closed=true;}}g_sigExecutedVolume=executed;if(executed>0){g_sigActualEntry=weightedEntry/executed;g_sigOpenedAt=openedAt;}if(position>0)g_sigPosition=(string)position;if(executed>0&&executed+0.0000001<g_sigRequestedVolume){g_sigExecutionState="PARTIALLY_FILLED";g_sigRationale="Cumulative broker deals reconciled; partial fill";}else if(executed+0.0000001>=g_sigRequestedVolume){bool positionFound=false;for(int i=PositionsTotal()-1;i>=0;i--){ulong ticket=PositionGetTicket(i);if(ticket>0&&(ulong)PositionGetInteger(POSITION_IDENTIFIER)==position&&(ulong)PositionGetInteger(POSITION_MAGIC)==(ulong)InpMagic){positionFound=true;double actualSl=PositionGetDouble(POSITION_SL),actualTp=PositionGetDouble(POSITION_TP);if((g_sigSL>0&&MathAbs(actualSl-g_sigSL)>SymbolInfoDouble(g_sigSymbol,SYMBOL_POINT)*2)||(g_sigTP>0&&MathAbs(actualTp-g_sigTP)>SymbolInfoDouble(g_sigSymbol,SYMBOL_POINT)*2)){g_sigExecutionState="POSITION_RECONCILED_SLTP_UNVERIFIED";g_sigRationale="Fill reconciled but broker SL/TP differs from requested protection";}else{g_sigExecutionState="POSITION_RECONCILED_SLTP_VERIFIED";g_sigRationale="Fill and broker position protection reconciled";}break;}}if(!positionFound)g_sigExecutionState=closed?"CLOSED_DEAL_RECONCILED":"FILLED_POSITION_NOT_FOUND";}else if(HistoryOrderSelect(order)){ENUM_ORDER_STATE os=(ENUM_ORDER_STATE)HistoryOrderGetInteger(order,ORDER_STATE);if(os==ORDER_STATE_CANCELED||os==ORDER_STATE_EXPIRED)g_sigExecutionState="CANCELLED_OR_EXPIRED";else if(os==ORDER_STATE_REJECTED)g_sigExecutionState="REJECTED";else if(os==ORDER_STATE_PLACED||os==ORDER_STATE_PARTIAL)g_sigExecutionState="ORDER_SUBMITTED";else g_sigExecutionState="UNKNOWN_REQUIRES_RECONCILIATION";}else g_sigExecutionState="UNKNOWN_REQUIRES_RECONCILIATION";}
void CancelNewsBlockedPendingOrders(){for(int i=OrdersTotal()-1;i>=0;i--){ulong ticket=OrderGetTicket(i);if(!ticket||OrderGetInteger(ORDER_MAGIC)!=(long)InpMagic)continue;string sym=OrderGetString(ORDER_SYMBOL);if(NewsClear(sym)){continue;}long typ=OrderGetInteger(ORDER_TYPE);if(typ!=ORDER_TYPE_BUY_LIMIT&&typ!=ORDER_TYPE_SELL_LIMIT&&typ!=ORDER_TYPE_BUY_STOP&&typ!=ORDER_TYPE_SELL_STOP&&typ!=ORDER_TYPE_BUY_STOP_LIMIT&&typ!=ORDER_TYPE_SELL_STOP_LIMIT)continue;if(trade.OrderDelete(ticket)){if(HistoryOrderSelect(ticket)){ENUM_ORDER_STATE state=(ENUM_ORDER_STATE)HistoryOrderGetInteger(ticket,ORDER_STATE);if(state!=ORDER_STATE_CANCELED&&state!=ORDER_STATE_EXPIRED)g_lastError="News blackout cancellation was not confirmed in broker history";}}else g_lastError="News blackout pending-order cancellation request failed";}}
void OnTradeTransaction(const MqlTradeTransaction &trans,const MqlTradeRequest &request,const MqlTradeResult &result){if(trans.order>0&&(g_sigOrder==""||(ulong)StringToInteger(g_sigOrder)==trans.order)){if(g_sigOrder=="")g_sigOrder=(string)trans.order;ReconcileOrder();PersistOrderState();}}
 string StateJson(){string state=g_state;if(g_state=="RUNNING"&&(!AccountIdentityMatches()||!TerminalInfoInteger(TERMINAL_CONNECTED)||!MQLInfoInteger(MQL_TRADE_ALLOWED)||!AccountInfoInteger(ACCOUNT_TRADE_ALLOWED)))state="ERROR";return state;}
string PositionsJson(){string a="[";bool first=true;for(int i=PositionsTotal()-1;i>=0;i--){ulong ticket=PositionGetTicket(i);if(!ticket||(ulong)PositionGetInteger(POSITION_MAGIC)!=(ulong)InpMagic)continue;if(!first)a+=",";first=false;ulong pid=(ulong)PositionGetInteger(POSITION_IDENTIFIER);a+=StringFormat("{\"ticket\":\"%I64u\",\"position_id\":\"%I64u\",\"symbol\":\"%s\",\"direction\":\"%s\",\"volume\":%.4f,\"open_price\":%.10f,\"stop_loss\":%.10f,\"take_profit\":%.10f,\"floating_profit\":%.2f,\"commission\":null,\"swap\":%.2f,\"fees\":null}",ticket,pid,Esc(PositionGetString(POSITION_SYMBOL)),PositionGetInteger(POSITION_TYPE)==POSITION_TYPE_BUY?"BUY":"SELL",PositionGetDouble(POSITION_VOLUME),PositionGetDouble(POSITION_PRICE_OPEN),PositionGetDouble(POSITION_SL),PositionGetDouble(POSITION_TP),PositionGetDouble(POSITION_PROFIT),PositionGetDouble(POSITION_SWAP));}return a+"]";}
string OrdersJson(){string a="[";bool first=true;for(int i=OrdersTotal()-1;i>=0;i--){ulong ticket=OrderGetTicket(i);if(!ticket||OrderGetInteger(ORDER_MAGIC)!=(long)InpMagic)continue;if(!first)a+=",";first=false;long typ=OrderGetInteger(ORDER_TYPE);string dir=(typ==ORDER_TYPE_SELL||typ==ORDER_TYPE_SELL_LIMIT||typ==ORDER_TYPE_SELL_STOP||typ==ORDER_TYPE_SELL_STOP_LIMIT)?"SELL":"BUY";a+=StringFormat("{\"ticket\":\"%I64u\",\"position_id\":\"%I64d\",\"symbol\":\"%s\",\"direction\":\"%s\",\"state\":\"PENDING\",\"volume\":%.4f,\"remaining_volume\":%.4f,\"open_price\":%.10f,\"stop_loss\":%.10f,\"take_profit\":%.10f}",ticket,OrderGetInteger(ORDER_POSITION_ID),Esc(OrderGetString(ORDER_SYMBOL)),dir,OrderGetDouble(ORDER_VOLUME_INITIAL),OrderGetDouble(ORDER_VOLUME_CURRENT),OrderGetDouble(ORDER_PRICE_OPEN),OrderGetDouble(ORDER_SL),OrderGetDouble(ORDER_TP));}return a+"]";}
string DealsJson()
{
   string output="[";
   bool first=true;
   datetime from=TimeCurrent()-86400*90;
   if(HistorySelect(from,TimeCurrent()))
   {
      int total=HistoryDealsTotal(),emitted=0;
      for(int i=total-1;i>=0&&emitted<30;i--)
      {
         ulong d=HistoryDealGetTicket(i);
         if(!d||(ulong)HistoryDealGetInteger(d,DEAL_MAGIC)!=(ulong)InpMagic)continue;
         long entry=HistoryDealGetInteger(d,DEAL_ENTRY);
         if(entry!=DEAL_ENTRY_OUT&&entry!=DEAL_ENTRY_OUT_BY&&entry!=DEAL_ENTRY_INOUT)continue;
         ulong pid=(ulong)HistoryDealGetInteger(d,DEAL_POSITION_ID);
         string sym=HistoryDealGetString(d,DEAL_SYMBOL),openDirection="UNAVAILABLE";
         double entryVolume=0,entryWeightedPrice=0,entryCommission=0,entryFees=0,entrySwap=0,positionExitVolume=0,openVolume=0;
         datetime opened=0;
         bool entryDataValid=true;
         for(int j=0;j<total;j++)
         {
            ulong e=HistoryDealGetTicket(j);
            if(!e||(ulong)HistoryDealGetInteger(e,DEAL_POSITION_ID)!=pid||(ulong)HistoryDealGetInteger(e,DEAL_MAGIC)!=(ulong)InpMagic||HistoryDealGetString(e,DEAL_SYMBOL)!=sym)continue;
            long et=HistoryDealGetInteger(e,DEAL_ENTRY);
            double ev=HistoryDealGetDouble(e,DEAL_VOLUME),ep=HistoryDealGetDouble(e,DEAL_PRICE);
            double ec=HistoryDealGetDouble(e,DEAL_COMMISSION),ef=HistoryDealGetDouble(e,DEAL_FEE),esw=HistoryDealGetDouble(e,DEAL_SWAP);
            if(!Finite(ev)||ev<=0||!Finite(ec)||!Finite(ef)||!Finite(esw)){entryDataValid=false;continue;}
            if(et==DEAL_ENTRY_IN)
            {
               if(!Finite(ep)||ep<=0){entryDataValid=false;continue;}
               entryVolume+=ev;entryWeightedPrice+=ev*ep;entryCommission+=ec;entryFees+=ef;entrySwap+=esw;
               datetime dt=(datetime)HistoryDealGetInteger(e,DEAL_TIME);
               if(opened==0||dt<opened){opened=dt;openDirection=HistoryDealGetInteger(e,DEAL_TYPE)==DEAL_TYPE_BUY?"BUY":"SELL";}
            }
            else if(et==DEAL_ENTRY_OUT||et==DEAL_ENTRY_OUT_BY)positionExitVolume+=ev;
            else if(et==DEAL_ENTRY_INOUT)entryDataValid=false;
         }
         bool stillOpen=false;
         for(int k=PositionsTotal()-1;k>=0;k--)
         {
            ulong positionTicket=PositionGetTicket(k);
            if(positionTicket>0&&(ulong)PositionGetInteger(POSITION_IDENTIFIER)==pid&&(ulong)PositionGetInteger(POSITION_MAGIC)==(ulong)InpMagic){stillOpen=true;openVolume=PositionGetDouble(POSITION_VOLUME);break;}
         }
         double tolerance=MathMax(0.0000001,entryVolume*0.00001);
         bool costsAvailable=entryDataValid&&entryVolume>0&&(stillOpen?MathAbs(entryVolume-positionExitVolume-openVolume)<=tolerance:MathAbs(positionExitVolume-entryVolume)<=tolerance);
         double entryPrice=entryVolume>0?entryWeightedPrice/entryVolume:0;
         string openedAt=entryVolume>0?BrokerTime(opened):"UNAVAILABLE";
         double closeVolume=HistoryDealGetDouble(d,DEAL_VOLUME),closeCommission=HistoryDealGetDouble(d,DEAL_COMMISSION),closeFee=HistoryDealGetDouble(d,DEAL_FEE),closeSwap=HistoryDealGetDouble(d,DEAL_SWAP);
         string costFields;
         if(costsAvailable&&Finite(closeVolume)&&closeVolume>0)
         {
            double share=closeVolume/entryVolume;
            costFields=StringFormat("\"commission\":%.2f,\"swap\":%.2f,\"fees\":%.2f",closeCommission+entryCommission*share,closeSwap+entrySwap*share,closeFee+entryFees*share);
         }
         else costFields=StringFormat("\"commission\":null,\"swap\":%.2f,\"fees\":null",closeSwap);
         if(!first)output+=",";
         first=false;emitted++;
         output+=StringFormat("{\"ticket\":\"%I64u\",\"position_id\":\"%I64u\",\"symbol\":\"%s\",\"direction\":\"%s\",\"entry_price\":%.10f,\"opened_at\":\"%s\",\"closed_at\":\"%s\",\"volume\":%.4f,\"price\":%.10f,\"profit\":%.2f,%s}",
                              d,pid,Esc(sym),openDirection,entryPrice,openedAt,BrokerTime((datetime)HistoryDealGetInteger(d,DEAL_TIME)),closeVolume,HistoryDealGetDouble(d,DEAL_PRICE),HistoryDealGetDouble(d,DEAL_PROFIT),costFields);
      }
   }
   return output+"]";
}
string LastSignalJson(){if(g_sigSymbol=="")return "null";return StringFormat("{\"state\":\"%s\",\"strategy\":\"%s\",\"execution_state\":\"%s\",\"symbol\":\"%s\",\"timeframe\":\"%s\",\"direction\":\"%s\",\"entry\":%.10f,\"actual_entry\":%.10f,\"submitted_at\":\"%s\",\"opened_at\":\"%s\",\"stop_loss\":%.10f,\"take_profit\":%.10f,\"risk_percent\":%.4f,\"requested_volume\":%.4f,\"executed_volume\":%.4f,\"rationale\":\"%s\",\"order_retcode\":\"%s\",\"order\":\"%s\",\"deal\":\"%s\",\"position\":\"%s\",\"cost_model\":\"%s\",\"news_status\":\"%s\",\"news_detail\":\"%s\",\"news_source\":\"%s\",\"news_event\":\"%s\",\"news_currency\":\"%s\",\"news_retrieved_at_ms\":%I64d}",g_sigState,Esc(g_strategy),g_sigExecutionState,Esc(g_sigSymbol),Esc(g_sigTf),Esc(g_sigDirection),g_sigEntry,g_sigActualEntry,(g_sigSubmittedAt>0?IsoUtc(g_sigSubmittedAt):"UNAVAILABLE"),(g_sigOpenedAt>0?BrokerTime(g_sigOpenedAt):"UNAVAILABLE"),g_sigSL,g_sigTP,g_sigRisk,g_sigRequestedVolume,g_sigExecutedVolume,Esc(g_sigRationale),Esc(g_sigRetcode),Esc(g_sigOrder),Esc(g_sigDeal),Esc(g_sigPosition),Esc(InpCostModel),Esc(g_newsStatus),Esc(g_newsDetail),Esc(g_newsSource),Esc(g_newsEvent),Esc(g_newsCurrency),g_newsRetrievedMs);}
