# Public deployments must terminate HTTPS at a trusted reverse proxy.
BRIDGE_DB_PATH=/data/bridge.sqlite3
ALLOW_LOOPBACK_HTTP=false
MAX_BODY_BYTES=65536
PAIR_RATE_LIMIT=10
HEARTBEAT_STALE_SECONDS=15
# Exact TLS reverse-proxy source IP/CIDR only; keep default for local proxy and never use '*'.
TRUSTED_PROXY_IPS=127.0.0.1
# Required public HTTPS origin; it must match MT5_MANAGED_SERVICE_URL in the APK build.
# Example: https://bridge.example.com
BRIDGE_BASE_URL=
# Required for managed execution. Generate a Fernet key and store only in the server secret store.
CREDENTIALS_FERNET_KEY=
# Strong operator-only credential; generate with python -c 'import secrets; print(secrets.token_urlsafe(48))'.
# Never include the value in Android or worker.toml.
WORKER_TOKEN=
# Required before automated execution can be enabled. The provider must return
# source, retrieval/coverage timestamps, affected currencies and event windows.
NEWS_PROVIDER_URL=
NEWS_PROVIDER_TOKEN=
NEWS_BLACKOUT_BEFORE_SECONDS=1800
NEWS_BLACKOUT_AFTER_SECONDS=1800
NEWS_MAX_AGE_SECONDS=120
