# Public deployments must terminate HTTPS at a trusted reverse proxy.
BRIDGE_DB_PATH=/data/bridge.sqlite3
ALLOW_LOOPBACK_HTTP=false
MAX_BODY_BYTES=65536
PAIR_RATE_LIMIT=10
HEARTBEAT_STALE_SECONDS=15
# Set BRIDGE_BASE_URL to your actual public HTTPS origin in the Android app setup.
# Example: https://bridge.example.com
BRIDGE_BASE_URL=
