{
  "name": "DestinedFX Codespaces DEMO host (Ubuntu 24.04 x86_64)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "hostRequirements": {
    "cpus": 2
  },
  "postCreateCommand": "bash deploy/codespaces/post-create.sh",
  "postStartCommand": "bash deploy/codespaces/start-demo.sh --background",
  "forwardPorts": [
    8000,
    8010,
    6080
  ],
  "portsAttributes": {
    "6080": {
      "label": "DestinedFX private noVNC (owner diagnostics only)",
      "onAutoForward": "ignore",
      "visibility": "private"
    },
    "8000": {
      "label": "DestinedFX Bridge (private until guarded DEMO readiness passes)",
      "onAutoForward": "silent",
      "visibility": "private"
    },
    "8010": {
      "label": "DestinedFX Management API (private until guarded DEMO readiness passes)",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "DISPLAY": ":99"
  }
}
