{
  "name": "DestinedFX Linux host (Ubuntu 24.04 x86_64)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "hostRequirements": {
    "cpus": 2
  },
  "postCreateCommand": "bash deploy/codespaces/post-create.sh",
  "postStartCommand": "python3 scripts/host/destinedfx_trigger_host.py start_all",
  "forwardPorts": [8000, 6080],
  "portsAttributes": {
    "8000": {
      "label": "DestinedFX bridge (private; K3 public guard required)",
      "onAutoForward": "notify",
      "visibility": "private"
    },
    "6080": {
      "label": "DestinedFX private noVNC",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "DISPLAY": ":99"
  }
}
