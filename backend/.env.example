# Copy to .env only on the owner-controlled host, then replace all placeholders.
# Use one randomly-generated alphanumeric database password in both values below.
POSTGRES_DB=app_management
POSTGRES_USER=app_management
POSTGRES_PASSWORD=replace_with_64_hex_chars
DATABASE_URL=postgresql+psycopg://app_management:replace_with_64_hex_chars@db:5432/app_management
ADMIN_EMAILS=admin@example.com
SESSION_TTL_SECONDS=2592000
MAX_REQUEST_BYTES=32768
RATE_LIMIT_PER_MINUTE=120
APP_DOMAIN=api.example.com
CADDY_EMAIL=operator@example.com
